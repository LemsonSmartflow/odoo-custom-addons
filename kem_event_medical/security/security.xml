<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="module_category_kem" model="ir.module.category">
        <field name="name">Event Medical Services</field>
        <field name="sequence">30</field>
    </record>

    <record id="privilege_kem" model="res.groups.privilege">
        <field name="name">Event Medical</field>
        <field name="category_id" ref="module_category_kem"/>
        <field name="sequence">30</field>
    </record>

    <record id="group_kem_user" model="res.groups">
        <field name="name">Operations Staff</field>
        <field name="privilege_id" ref="privilege_kem"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_kem_manager" model="res.groups">
        <field name="name">Operations Manager</field>
        <field name="privilege_id" ref="privilege_kem"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_kem_user')), (4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_kem_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_kem"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[(4, ref('group_kem_manager'))]"/>
    </record>

    <!-- Company isolation, consistent with the other addons in this repository. -->
    <record id="rule_company_kem_booking" model="ir.rule">
        <field name="name">Event Medical company isolation: booking</field>
        <field name="model_id" ref="model_kem_event_booking"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_company_kem_job" model="ir.rule">
        <field name="name">Event Medical company isolation: job</field>
        <field name="model_id" ref="model_kem_operational_job"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_company_kem_document" model="ir.rule">
        <field name="name">Event Medical company isolation: document</field>
        <field name="model_id" ref="model_kem_document_record"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
