<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="view_kem_document_list" model="ir.ui.view">
        <field name="name">kem.document.record.list</field>
        <field name="model">kem.document.record</field>
        <field name="arch" type="xml">
            <list string="Documents">
                <field name="name"/>
                <field name="category"/>
                <field name="partner_id"/>
                <field name="booking_id"/>
                <field name="date"/>
                <field name="access_level" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_kem_document_form" model="ir.ui.view">
        <field name="name">kem.document.record.form</field>
        <field name="model">kem.document.record</field>
        <field name="arch" type="xml">
            <form string="Document Record">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_file" type="object" class="oe_stat_button" icon="fa-file" invisible="not attachment_id">
                            <div class="o_stat_info"><span class="o_stat_text">Open File</span></div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Document Name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="reference"/>
                        <field name="category"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="partner_id"/>
                        <field name="booking_id"/>
                        <field name="job_id"/>
                        <field name="date"/>
                        <field name="access_level"/>
                    </group>
                    <group>
                        <field name="attachment_id"/>
                    </group>
                    <group><field name="notes" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kem_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">kem.document.record</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
