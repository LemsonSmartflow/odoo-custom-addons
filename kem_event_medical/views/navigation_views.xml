<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <menuitem id="menu_kem_root" name="Event Medical" sequence="90"
              groups="group_kem_user"/>

    <menuitem id="menu_kem_dashboard" name="Dashboard" parent="menu_kem_root"
              action="action_kem_dashboard" sequence="5"/>
    <menuitem id="menu_kem_booking" name="Event Bookings" parent="menu_kem_root"
              action="action_kem_booking" sequence="10"/>
    <menuitem id="menu_kem_job" name="Operational Jobs" parent="menu_kem_root"
              action="action_kem_job" sequence="20"/>
    <menuitem id="menu_kem_document" name="Documents" parent="menu_kem_root"
              action="action_kem_document" sequence="30" groups="group_kem_manager"/>

    <!-- Cross-application shortcuts: the custom records stay linked to native apps. -->
    <menuitem id="menu_kem_connected_root" name="Connected Applications" parent="menu_kem_root" sequence="80"/>

    <record id="action_kem_connected_crm" model="ir.actions.act_window">
        <field name="name">CRM Opportunities</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('type', '=', 'opportunity')]</field>
    </record>
    <menuitem id="menu_kem_connected_crm" name="CRM" parent="menu_kem_connected_root"
              action="action_kem_connected_crm" sequence="10"/>

    <record id="action_kem_connected_sale" model="ir.actions.act_window">
        <field name="name">Quotations</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ['draft', 'sent', 'sale'])]</field>
    </record>
    <menuitem id="menu_kem_connected_sale" name="Sales" parent="menu_kem_connected_root"
              action="action_kem_connected_sale" sequence="20"/>

    <record id="action_kem_connected_employee" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_kem_connected_employee" name="Employees" parent="menu_kem_connected_root"
              action="action_kem_connected_employee" sequence="30"/>

    <record id="action_kem_connected_fleet" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">fleet.vehicle</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_kem_connected_fleet" name="Fleet" parent="menu_kem_connected_root"
              action="action_kem_connected_fleet" sequence="40"/>

    <record id="action_kem_connected_inventory" model="ir.actions.act_window">
        <field name="name">Stock</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_kem_connected_inventory" name="Inventory" parent="menu_kem_connected_root"
              action="action_kem_connected_inventory" sequence="50"/>

    <record id="action_kem_connected_maintenance" model="ir.actions.act_window">
        <field name="name">Maintenance Requests</field>
        <field name="res_model">maintenance.request</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <menuitem id="menu_kem_connected_maintenance" name="Maintenance" parent="menu_kem_connected_root"
              action="action_kem_connected_maintenance" sequence="60"/>

    <record id="action_kem_connected_invoice" model="ir.actions.act_window">
        <field name="name">Customer Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice')]</field>
    </record>
    <menuitem id="menu_kem_connected_invoice" name="Invoicing" parent="menu_kem_connected_root"
              action="action_kem_connected_invoice" sequence="70" groups="account.group_account_readonly"/>

</odoo>
