<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="action_kem_website_leads" model="ir.actions.act_window">
        <field name="name">Website Enquiries</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain" eval="[('source_id', '=', ref('kem_event_medical.utm_source_website_enquiry'))]"/>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Leads captured from the website will appear here.</p></field>
    </record>

    <menuitem id="menu_kem_website_leads" name="Website Leads" parent="menu_kem_root"
              action="action_kem_website_leads" sequence="12"/>

</odoo>
