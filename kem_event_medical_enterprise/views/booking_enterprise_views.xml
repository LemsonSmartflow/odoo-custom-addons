<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="view_kem_booking_form_enterprise" model="ir.ui.view">
        <field name="name">kem.event.booking.form.enterprise</field>
        <field name="model">kem.event.booking</field>
        <field name="inherit_id" ref="kem_event_medical.view_kem_booking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_for_signature" type="object" string="Send for Signature"
                        invisible="state not in ['confirmed', 'planning', 'ready']"/>
                <button name="action_refresh_sign_status" type="object" string="Refresh Sign Status"
                        invisible="not sign_request_id"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_planning_slots" type="object" class="oe_stat_button" icon="fa-calendar-o">
                    <field name="planning_slot_ids" widget="statinfo" string="Planning"/>
                </button>
                <button name="action_view_fieldservice_tasks" type="object" class="oe_stat_button" icon="fa-wrench">
                    <field name="fieldservice_task_ids" widget="statinfo" string="Field Tasks"/>
                </button>
                <button name="action_view_documents_app" type="object" class="oe_stat_button" icon="fa-folder-open">
                    <field name="documents_document_ids" widget="statinfo" string="Documents"/>
                </button>
            </xpath>
            <xpath expr="//group[@string='Planning']" position="after">
                <group string="Enterprise integrations">
                    <field name="sign_request_id"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
