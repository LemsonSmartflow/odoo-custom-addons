<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_report_rental_agreement" model="ir.actions.report">
        <field name="name">Rental Agreement</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">car_rental_management.report_rental_agreement</field>
        <field name="report_file">car_rental_management.report_rental_agreement</field>
        <field name="print_report_name">'Rental Agreement - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">form</field>
    </record>

    <record id="action_report_inspection" model="ir.actions.report">
        <field name="name">Inspection Report</field>
        <field name="model">car.rental.inspection</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">car_rental_management.report_rental_inspection</field>
        <field name="report_file">car_rental_management.report_rental_inspection</field>
        <field name="print_report_name">'Inspection - %s' % (object.name)</field>
        <field name="binding_model_id" ref="car_rental_management.model_car_rental_inspection"/>
        <field name="binding_view_types">form</field>
    </record>

    <template id="report_rental_agreement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        <h2 class="text-center mt-4">Rental Agreement</h2>
                        <div class="row mb-4">
                            <div class="col-6">
                                <h4>Customer</h4>
                                <t t-out="doc.partner_id.name or ''"/><br/>
                                <t t-out="doc.partner_id.street or ''"/><br/>
                                <t t-out="doc.partner_id.phone or ''"/><br/>
                                <t t-out="doc.partner_id.email or ''"/>
                            </div>
                            <div class="col-6">
                                <h4>Rental Order</h4>
                                <strong t-out="doc.name or ''"/><br/>
                                Date: <t t-out="doc.date_order or ''"/>
                            </div>
                        </div>
                        <table class="table table-sm table-bordered">
                            <tr><td style="width: 35%"><strong>Vehicle</strong></td>
                                <td><t t-out="doc.allocated_vehicle_id.rental_fleet_id or ''"/>
                                    <t t-if="doc.allocated_vehicle_id.license_plate"> - <t t-out="doc.allocated_vehicle_id.license_plate"/></t>
                                </td></tr>
                            <tr><td><strong>VIN / Chassis</strong></td><td><t t-out="doc.allocated_vehicle_id.vin_sn or ''"/></td></tr>
                            <tr><td><strong>Vehicle Category</strong></td><td><t t-out="doc.rental_vehicle_category_id.name or ''"/></td></tr>
                            <tr><td><strong>Destination</strong></td><td><t t-out="doc.rental_destination_id.name or ''"/></td></tr>
                            <tr><td><strong>Pickup Date</strong></td><td><t t-out="doc.rental_pickup_date or ''"/></td></tr>
                            <tr><td><strong>Return Date</strong></td><td><t t-out="doc.rental_return_date or ''"/></td></tr>
                            <tr><td><strong>Duration</strong></td><td><t t-out="doc.rental_days or ''"/> day(s)</td></tr>
                            <tr><td><strong>Daily Rate</strong></td>
                                <td><span t-out="format_amount(doc.rental_daily_rate, doc.currency_id) or ''"/> / day</td></tr>
                            <tr><td><strong>Total</strong></td>
                                <td><span t-out="format_amount(doc.amount_total, doc.currency_id) or ''"/></td></tr>
                            <tr><td><strong>Refundable Security Deposit</strong></td>
                                <td><span t-out="format_amount(doc.security_deposit_amount, doc.currency_id) or ''"/></td></tr>
                            <tr><td><strong>Opening Mileage</strong></td><td><t t-out="doc.pickup_mileage or ''"/> km</td></tr>
                        </table>
                        <h5>Rental Conditions</h5>
                        <ul>
                            <li>The vehicle must be returned on or before the return date with the same fuel level; late returns and fuel recovery are charged per the current company policy.</li>
                            <li>The customer is responsible for any damage beyond normal wear and tear. Damage is assessed at return and recovered from the refundable deposit or invoiced.</li>
                            <li>The security deposit is refundable after the return inspection, less approved charges.</li>
                            <li>The odometer opening reading and fuel level are recorded at pickup in the mandatory pickup inspection.</li>
                        </ul>
                        <div class="row mt-5">
                            <div class="col-6 text-center">
                                <p>Customer Signature: ______________________</p>
                            </div>
                            <div class="col-6 text-center">
                                <p>For the Company: ______________________</p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_rental_inspection">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center mt-4">
                            <t t-if="doc.inspection_type == 'pickup'">Pickup / Handover Inspection</t>
                            <t t-else="">Return Inspection</t>
                        </h2>
                        <div class="row mb-4">
                            <div class="col-6">
                                <h4>Inspection</h4>
                                <strong t-out="doc.name or ''"/><br/>
                                Rental: <t t-out="doc.rental_order_id.name or ''"/><br/>
                                Inspector: <t t-out="doc.inspector_id.name or ''"/><br/>
                                Date: <t t-out="doc.inspection_date or ''"/>
                            </div>
                            <div class="col-6">
                                <h4>Vehicle</h4>
                                <t t-out="doc.vehicle_id.rental_fleet_id or ''"/><br/>
                                <t t-out="doc.vehicle_id.license_plate or ''"/>
                            </div>
                        </div>
                        <table class="table table-sm table-bordered">
                            <tr>
                                <th style="width: 20%">Area</th>
                                <th style="width: 45%">Check</th>
                                <th style="width: 35%">Result</th>
                            </tr>
                            <t t-foreach="doc.line_ids" t-as="line">
                                <tr>
                                    <td><t t-out="dict(line._fields['area'].selection).get(line.area) or line.area"/></td>
                                    <td><t t-out="line.item"/></td>
                                    <td t-out="dict(line._fields['result'].selection).get(line.result) or line.result"/>
                                </tr>
                            </t>
                        </table>
                        <table class="table table-sm table-bordered">
                            <tr><td style="width: 35%"><strong>Odometer (km)</strong></td><td><t t-out="doc.mileage or ''"/></td></tr>
                            <tr><td><strong>Fuel Level</strong></td><td><t t-out="dict(doc._fields['fuel_level'].selection).get(doc.fuel_level) or ''"/></td></tr>
                            <tr><td><strong>Cleanliness</strong></td><td><t t-out="dict(doc._fields['cleanliness'].selection).get(doc.cleanliness) or ''"/></td></tr>
                            <tr><td><strong>Damage Detected</strong></td><td><t t-out="'Yes' if doc.damage_detected else 'No'"/></td></tr>
                        </table>
                        <p><strong>Notes:</strong> <t t-out="doc.notes or ''"/></p>
                        <div class="row mt-5">
                            <div class="col-6 text-center">
                                <p>Customer Signature: ______________________</p>
                            </div>
                            <div class="col-6 text-center">
                                <p>Inspector Signature: ______________________</p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
