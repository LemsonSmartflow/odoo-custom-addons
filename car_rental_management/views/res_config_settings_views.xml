<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_rental" model="ir.ui.view">
        <field name="name">res.config.settings.form.rental</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Car Rental" name="car_rental_management">
                    <block title="Accounting">
                        <setting string="Customer Rental Deposits Account" help="Refundable security deposits are liabilities, not rental revenue">
                            <field name="rental_deposit_liability_account_id"/>
                        </setting>
                        <setting string="Damage/Recovery Income Account" help="Income account for approved damage, cleaning, fuel and late recovery charges">
                            <field name="rental_recovery_income_account_id"/>
                        </setting>
                        <setting string="Deposit Bank/Cash Journal" help="Journal used to post deposit receipts, applications and refunds">
                            <field name="rental_deposit_journal_id"/>
                        </setting>
                    </block>
                    <block title="Late Returns">
                        <setting string="Grace Period" help="Grace period in hours before late-return charges apply">
                            <field name="rental_late_grace_hours"/>
                        </setting>
                        <setting string="Hourly Rate" help="Leave 0 to default to one twenty-fourth of the applicable daily rate">
                            <field name="rental_late_hourly_rate"/>
                        </setting>
                        <setting string="Extra-Day Threshold" help="Beyond this many late hours, charges switch to full rental days">
                            <field name="rental_late_extra_day_threshold"/>
                        </setting>
                    </block>
                    <block title="Policies">
                        <setting string="Block on Expired Compliance" help="Block handover when insurance, road licence or fitness is expired (otherwise warn)">
                            <field name="rental_compliance_block"/>
                        </setting>
                        <setting string="Block on Non-Working Tracker" help="Block handover when the vehicle tracker is not working (otherwise warn)">
                            <field name="rental_tracker_block"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
