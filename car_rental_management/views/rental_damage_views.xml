<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_rental_damage_form" model="ir.ui.view">
        <field name="name">car.rental.damage.form</field>
        <field name="model">car.rental.damage</field>
        <field name="arch" type="xml">
            <form string="Damage Assessment">
                <header>
                    <button string="Approve" name="action_approve" type="object" class="btn-primary" invisible="approval_status != 'draft'"/>
                    <button string="Reject" name="action_reject" type="object" invisible="approval_status != 'draft'"/>
                    <button string="Apply Deposit" name="action_apply_deposit" type="object" invisible="approval_status != 'approved' or deposit_applied > 0"/>
                    <button string="Invoice Balance" name="action_create_balance_invoice" type="object" invisible="approval_status != 'approved'"/>
                    <button string="Create Repair Request" name="action_create_repair_request" type="object" invisible="not repair_request_id and approval_status == 'approved'"/>
                    <field name="approval_status" widget="statusbar" statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Damage">
                            <field name="rental_order_id"/>
                            <field name="vehicle_id"/>
                            <field name="customer_id"/>
                            <field name="inspection_id"/>
                            <field name="damage_type"/>
                            <field name="severity"/>
                        </group>
                        <group string="Assessment">
                            <field name="estimated_cost"/>
                            <field name="final_cost"/>
                            <field name="customer_charge"/>
                            <field name="deposit_applied"/>
                            <field name="additional_invoice_id"/>
                            <field name="repair_request_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Approval">
                            <field name="approved_by" widget="many2one_avatar_user"/>
                            <field name="approved_date"/>
                        </group>
                        <group string="Photos">
                            <field name="attachment_ids" nolabel="1" widget="many2many_binary"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rental_damage_list" model="ir.ui.view">
        <field name="name">car.rental.damage.list</field>
        <field name="model">car.rental.damage</field>
        <field name="arch" type="xml">
            <list string="Damage Assessments" decoration-danger="severity == 'major'" decoration-warning="severity == 'moderate'">
                <field name="name"/>
                <field name="rental_order_id"/>
                <field name="vehicle_id"/>
                <field name="customer_id" optional="show"/>
                <field name="damage_type"/>
                <field name="severity"/>
                <field name="estimated_cost" optional="hide"/>
                <field name="final_cost" optional="show"/>
                <field name="customer_charge" sum="Total"/>
                <field name="deposit_applied" optional="show"/>
                <field name="approval_status" widget="badge" decoration-success="approval_status == 'approved'" decoration-info="approval_status == 'draft'" decoration-muted="approval_status == 'rejected'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_rental_damage_search" model="ir.ui.view">
        <field name="name">car.rental.damage.search</field>
        <field name="model">car.rental.damage</field>
        <field name="arch" type="xml">
            <search string="Search Damage Assessments">
                <field name="name"/>
                <field name="rental_order_id"/>
                <field name="vehicle_id"/>
                <filter string="Pending Approval" name="draft" domain="[('approval_status', '=', 'draft')]"/>
                <filter string="Approved" name="approved" domain="[('approval_status', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('approval_status', '=', 'rejected')]"/>
                <group>
                    <filter string="Rental Order" name="group_order" context="{'group_by': 'rental_order_id'}"/>
                    <filter string="Vehicle" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter string="Damage Type" name="group_type" context="{'group_by': 'damage_type'}"/>
                    <filter string="Severity" name="group_severity" context="{'group_by': 'severity'}"/>
                    <filter string="Approval Status" name="group_approval" context="{'group_by': 'approval_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rental_damage" model="ir.actions.act_window">
        <field name="name">Damage Assessments</field>
        <field name="res_model">car.rental.damage</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record a damage assessment</p>
            <p>Damage detected at return requires an assessment, manager approval, and deposit application or balance invoicing.</p>
        </field>
    </record>
</odoo>
