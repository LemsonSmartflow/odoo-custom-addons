<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Website Vehicle Catalog -->
    <template id="website_vehicle_catalog" name="Vehicle Catalog">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <!-- Hero Section -->
                <div class="container py-5">
                    <h1 class="text-center mb-4">Our Vehicle Fleet</h1>
                    <p class="text-center text-muted mb-5">Choose from our wide range of vehicles for your perfect trip</p>

                    <!-- Filters -->
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <label for="category_filter">Category</label>
                            <select id="category_filter" class="form-select" onchange="window.location.href='?category='+this.value">
                                <option value="">All Categories</option>
                                <t t-foreach="categories" t-as="cat">
                                    <option t-att-value="cat.id" t-att-selected="selected_category == cat.id" t-esc="cat.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="destination_filter">Destination</label>
                            <select id="destination_filter" class="form-select" onchange="window.location.href='?destination='+this.value">
                                <option value="">All Destinations</option>
                                <t t-foreach="destinations" t-as="dest">
                                    <option t-att-value="dest.id" t-att-selected="selected_destination == dest.id" t-esc="dest.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <a href="/vehicles" class="btn btn-outline-secondary">Clear Filters</a>
                        </div>
                    </div>

                    <!-- Vehicle Grid -->
                    <div class="row">
                        <t t-foreach="vehicles" t-as="vehicle">
                            <div class="col-lg-4 col-md-6 mb-4">
                                <div class="card h-100 shadow-sm vehicle-card">
                                    <t t-if="vehicle.image_128">
                                        <img t-att-src="image_data_uri(vehicle.image_128)" class="card-img-top" t-att-alt="vehicle.name" style="height: 200px; object-fit: cover;"/>
                                    </t>
                                    <t t-else="">
                                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                            <i class="fa fa-car fa-3x text-muted"/>
                                        </div>
                                    </t>
                                    <div class="card-body">
                                        <h5 class="card-title" t-esc="vehicle.name"/>
                                        <p t-if="vehicle.rental_category_id" class="text-muted small" t-esc="vehicle.rental_category_id.name"/>
                                        <t t-if="vehicle.website_price_ids">
                                            <p class="card-text fw-bold text-primary">
                                                From BWP <t t-esc="vehicle.website_price_ids[0].daily_rate" t-options='{"widget": "float", "precision": 2}'/>/day
                                            </p>
                                        </t>
                                        <t t-if="vehicle.fuel_type">
                                            <span class="badge bg-secondary me-1" t-esc="vehicle.fuel_type"/>
                                        </t>
                                        <t t-if="vehicle.transmission_type">
                                            <span class="badge bg-info" t-esc="vehicle.transmission_type"/>
                                        </t>
                                    </div>
                                    <div class="card-footer bg-white">
                                        <a t-att-href="'/vehicles/' + vehicle.slug" class="btn btn-primary w-100">View Details</a>
                                    </div>
                                </div>
                            </div>
                        </t>
                        <t t-if="not vehicles">
                            <div class="col-12 text-center py-5">
                                <i class="fa fa-car fa-3x text-muted mb-3"/>
                                <p class="text-muted">No vehicles found matching your criteria.</p>
                                <a href="/vehicles" class="btn btn-primary">View All Vehicles</a>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Vehicle Detail Meta Tags (injected into <head>) -->
    <template id="website_vehicle_detail_meta" name="Vehicle Detail Meta" inherit_id="website.layout" active="True">
        <xpath expr="//head" position="inside">
            <t t-set="meta_vehicle" t-value="request.httprequest.path.startswith('/vehicles/') and request.httprequest.path != '/vehicles'"/>
            <t t-if="meta_vehicle">
                <script type="text/javascript">
                    var vehicleSlug = window.location.pathname.split('/vehicles/')[1];
                    if (vehicleSlug) {
                        document.title = vehicleSlug.replace(/-/g, ' ').replace(/\b\w/g, function(c) { return c.toUpperCase(); }) + ' | City Delights Car Rental';
                    }
                </script>
            </t>
        </xpath>
    </template>

    <!-- Website Vehicle Detail -->
    <template id="website_vehicle_detail" name="Vehicle Detail">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container py-5">
                    <!-- Breadcrumb -->
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/vehicles">Vehicles</a></li>
                            <li class="breadcrumb-item active" t-esc="vehicle.name"/>
                        </ol>
                    </nav>

                    <div class="row">
                        <!-- Vehicle Images -->
                        <div class="col-lg-7 mb-4">
                            <div class="card shadow-sm">
                                <t t-if="vehicle.image_1920">
                                    <img t-att-src="image_data_uri(vehicle.image_1920)" class="card-img-top" t-att-alt="vehicle.name"/>
                                </t>
                                <t t-else="">
                                    <div class="bg-light d-flex align-items-center justify-content-center" style="height: 400px;">
                                        <i class="fa fa-car fa-5x text-muted"/>
                                    </div>
                                </t>
                            </div>

                            <!-- Gallery Thumbnails -->
                            <t t-if="images">
                                <div class="row mt-3">
                                    <t t-foreach="images" t-as="img">
                                        <div class="col-3 mb-2">
                                            <a href="#" class="d-block" data-bs-toggle="modal" t-att-data-bs-target="'#imageModal' + img.id">
                                                <img t-att-src="image_data_uri(img.image_128)" class="img-fluid rounded" t-att-alt="img.name or ''" style="height: 80px; object-fit: cover;"/>
                                            </a>
                                        </div>
                                    </t>
                                </div>
                            </t>
                        </div>

                        <!-- Vehicle Info -->
                        <div class="col-lg-5">
                            <h1 t-esc="vehicle.name"/>
                            <t t-if="vehicle.rental_category_id">
                                <span class="badge bg-primary mb-3" t-esc="vehicle.rental_category_id.name"/>
                            </t>

                            <div class="card mb-4">
                                <div class="card-body">
                                    <h5 class="card-title">Vehicle Details</h5>
                                    <table class="table table-borderless">
                                        <tr t-if="vehicle.rental_fleet_id">
                                            <td class="text-muted">Fleet ID</td>
                                            <td t-esc="vehicle.rental_fleet_id"/>
                                        </tr>
                                        <tr t-if="vehicle.license_plate">
                                            <td class="text-muted">License Plate</td>
                                            <td t-esc="vehicle.license_plate"/>
                                        </tr>
                                        <tr t-if="vehicle.seats">
                                            <td class="text-muted">Seats</td>
                                            <td t-esc="vehicle.seats"/>
                                        </tr>
                                        <tr t-if="vehicle.fuel_type">
                                            <td class="text-muted">Fuel Type</td>
                                            <td t-esc="vehicle.fuel_type"/>
                                        </tr>
                                        <tr t-if="vehicle.transmission_type">
                                            <td class="text-muted">Transmission</td>
                                            <td t-esc="vehicle.transmission_type"/>
                                        </tr>
                                        <tr t-if="vehicle.color">
                                            <td class="text-muted">Color</td>
                                            <td t-esc="vehicle.color"/>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <t t-if="vehicle.website_description">
                                <div class="card mb-4">
                                    <div class="card-body">
                                        <h5 class="card-title">Description</h5>
                                        <div t-field="vehicle.website_description"/>
                                    </div>
                                </div>
                            </t>

                            <t t-if="vehicle.website_price_ids">
                                <div class="card mb-4">
                                    <div class="card-body">
                                        <h5 class="card-title">Pricing (BWP)</h5>
                                        <table class="table table-sm">
                                            <thead>
                                                <tr>
                                                    <th>Destination</th>
                                                    <th>Min Days</th>
                                                    <th>Daily</th>
                                                    <th>Weekly</th>
                                                    <th>Monthly</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="prices" t-as="price">
                                                    <tr>
                                                        <td t-esc="price.destination_id.name"/>
                                                        <td t-esc="price.min_days"/>
                                                        <td t-esc="price.daily_rate" t-options='{"widget": "float", "precision": 2}'/>
                                                        <td t-esc="price.weekly_rate" t-options='{"widget": "float", "precision": 2}'/>
                                                        <td t-esc="price.monthly_rate" t-options='{"widget": "float", "precision": 2}'/>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </t>

                            <a t-att-href="'/vehicles/' + vehicle.slug + '/book'" class="btn btn-primary btn-lg w-100">
                                <i class="fa fa-calendar me-2"/>Book This Vehicle
                            </a>
                        </div>
                    </div>

                    <!-- Related Vehicles -->
                    <t t-if="related_vehicles">
                        <h3 class="mt-5 mb-4">Related Vehicles</h3>
                        <div class="row">
                            <t t-foreach="related_vehicles" t-as="rv">
                                <div class="col-md-4 mb-4">
                                    <div class="card h-100 shadow-sm">
                                        <t t-if="rv.image_128">
                                            <img t-att-src="image_data_uri(rv.image_128)" class="card-img-top" t-att-alt="rv.name" style="height: 150px; object-fit: cover;"/>
                                        </t>
                                        <div class="card-body">
                                            <h5 class="card-title" t-esc="rv.name"/>
                                            <a t-att-href="'/vehicles/' + rv.slug" class="btn btn-outline-primary btn-sm">View Details</a>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>
            </div>

            <!-- Image Gallery Modal -->
            <t t-foreach="images" t-as="img">
                <div class="modal fade" t-att-id="'imageModal' + img.id" tabindex="-1">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" t-esc="img.name or vehicle.name"/>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"/>
                            </div>
                            <div class="modal-body text-center">
                                <img t-att-src="image_data_uri(img.image_1920)" class="img-fluid" t-att-alt="img.name or ''"/>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <!-- Booking Form -->
    <template id="website_booking_form" name="Booking Form">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="card shadow">
                                <div class="card-header bg-primary text-white">
                                    <h4 class="mb-0">
                                        <i class="fa fa-calendar me-2"/>
                                        Book: <t t-esc="vehicle.name"/>
                                    </h4>
                                </div>
                                <div class="card-body">
                                    <form action="/vehicles/booking/submit" method="POST">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <input type="hidden" name="vehicle_id" t-att-value="vehicle.id"/>

                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <label for="name" class="form-label">Full Name *</label>
                                                <input type="text" class="form-control" id="name" name="name" required="required"/>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="email" class="form-label">Email Address *</label>
                                                <input type="email" class="form-control" id="email" name="email" required="required"/>
                                            </div>
                                        </div>

                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <label for="phone" class="form-label">Phone Number</label>
                                                <input type="tel" class="form-control" id="phone" name="phone"/>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="destination_id" class="form-label">Destination *</label>
                                                <select class="form-select" id="destination_id" name="destination_id" required="required">
                                                    <option value="">Select Destination</option>
                                                    <t t-foreach="destinations" t-as="dest">
                                                        <option t-att-value="dest.id" t-esc="dest.name"/>
                                                    </t>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="row mb-4">
                                            <div class="col-md-6">
                                                <label for="pickup_date" class="form-label">Pickup Date *</label>
                                                <input type="date" class="form-control" id="pickup_date" name="pickup_date" required="required"/>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="return_date" class="form-label">Return Date *</label>
                                                <input type="date" class="form-control" id="return_date" name="return_date" required="required"/>
                                            </div>
                                        </div>

                                        <div class="alert alert-info">
                                            <i class="fa fa-info-circle me-2"/>
                                            This is a booking request. Our team will contact you to confirm availability and finalize your reservation.
                                        </div>

                                        <button type="submit" class="btn btn-primary btn-lg w-100">
                                            <i class="fa fa-paper-plane me-2"/>Submit Booking Request
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Booking Confirmation -->
    <template id="website_booking_confirmation" name="Booking Confirmation">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="card shadow text-center">
                                <div class="card-body p-5">
                                    <i class="fa fa-check-circle fa-4x text-success mb-4"/>
                                    <h2>Booking Request Received!</h2>
                                    <p class="lead text-muted mb-4">
                                        Thank you for your interest in renting <strong t-esc="vehicle.name"/>. 
                                        Our team will contact you shortly to confirm your reservation.
                                    </p>
                                    <div class="card bg-light mb-4">
                                        <div class="card-body">
                                            <h5>Reference Number</h5>
                                            <p class="h3 text-primary" t-esc="order.name"/>
                                        </div>
                                    </div>
                                    <div class="row text-start mb-4">
                                        <div class="col-md-6">
                                            <h6 class="text-muted">Vehicle</h6>
                                            <p t-esc="vehicle.name"/>
                                        </div>
                                        <div class="col-md-6">
                                            <h6 class="text-muted">Partner</h6>
                                            <p t-esc="order.partner_id.name"/>
                                        </div>
                                    </div>
                                    <a href="/vehicles" class="btn btn-primary me-2">
                                        <i class="fa fa-car me-2"/>Browse More Vehicles
                                    </a>
                                    <a t-if="request.env.user._is_public() == False" href="/my/rentals" class="btn btn-outline-primary">
                                        <i class="fa fa-list me-2"/>My Rentals
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Portal My Rentals -->
    <template id="portal_my_rentals" name="My Rentals">
        <t t-call="website.portal">
            <div class="container">
                <h2 class="mb-4">My Rental Orders</h2>
                <t t-if="orders">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Order #</th>
                                    <th>Vehicle Category</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="orders" t-as="order">
                                    <tr>
                                        <td t-esc="order.name"/>
                                        <td t-esc="order.rental_vehicle_category_id.name or '-'"/>
                                        <td>
                                            <span class="badge" t-att-class="{
                                                'bg-warning': order.state == 'draft',
                                                'bg-info': order.state == 'sale',
                                                'bg-success': order.state == 'done',
                                                'bg-danger': order.state == 'cancel',
                                            }" t-esc="order.state"/>
                                        </td>
                                        <td t-esc="order.date_order"/>
                                        <td>
                                            <a t-att-href="'/my/rentals/' + str(order.id)" class="btn btn-sm btn-outline-primary">View</a>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
                <t t-else="">
                    <div class="text-center py-5">
                        <i class="fa fa-car fa-3x text-muted mb-3"/>
                        <p class="text-muted">You have no rental orders yet.</p>
                        <a href="/vehicles" class="btn btn-primary">Browse Vehicles</a>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- Portal Rental Detail -->
    <template id="portal_rental_detail" name="Rental Detail">
        <t t-call="website.portal">
            <div class="container">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/my/rentals">My Rentals</a></li>
                        <li class="breadcrumb-item active" t-esc="order.name"/>
                    </ol>
                </nav>

                <div class="card shadow">
                    <div class="card-header bg-primary text-white d-flex justify-content-between">
                        <h4 class="mb-0" t-esc="order.name"/>
                        <span class="badge" t-att-class="{
                            'bg-warning': order.state == 'draft',
                            'bg-info': order.state == 'sale',
                            'bg-success': order.state == 'done',
                            'bg-danger': order.state == 'cancel',
                        }" t-esc="order.state"/>
                    </div>
                    <div class="card-body">
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <h6 class="text-muted">Partner</h6>
                                <p t-esc="order.partner_id.name"/>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-muted">Date</h6>
                                <p t-esc="order.date_order"/>
                            </div>
                        </div>

                        <h6 class="text-muted">Order Lines</h6>
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Description</th>
                                        <th class="text-end">Quantity</th>
                                        <th class="text-end">Unit Price</th>
                                        <th class="text-end">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="order.order_line" t-as="line">
                                        <tr>
                                            <td t-esc="line.name"/>
                                            <td class="text-end" t-esc="line.product_uom_qty"/>
                                            <td class="text-end" t-esc="line.price_unit"/>
                                            <td class="text-end" t-esc="line.price_subtotal"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <div class="row justify-content-end">
                            <div class="col-md-4">
                                <table class="table table-sm">
                                    <tr>
                                        <td><strong>Subtotal</strong></td>
                                        <td class="text-end" t-esc="order.amount_untaxed"/>
                                    </tr>
                                    <tr>
                                        <td><strong>Taxes</strong></td>
                                        <td class="text-end" t-esc="order.amount_tax"/>
                                    </tr>
                                    <tr class="table-primary">
                                        <td><strong>Total</strong></td>
                                        <td class="text-end"><strong t-esc="order.amount_total"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <t t-if="order.note">
                            <div class="mt-4">
                                <h6 class="text-muted">Notes</h6>
                                <p t-field="order.note"/>
                            </div>
                        </t>
                    </div>
                </div>

                <div class="mt-4">
                    <a href="/my/rentals" class="btn btn-outline-secondary">
                        <i class="fa fa-arrow-left me-2"/>Back to My Rentals
                    </a>
                </div>
            </div>
        </t>
    </template>

</odoo>
