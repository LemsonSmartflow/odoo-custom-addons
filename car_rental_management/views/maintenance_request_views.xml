<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="maintenance_request_view_form_inherit_rental" model="ir.ui.view">
        <field name="name">maintenance.request.form.rental</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <field name="equipment_id" position="after">
                <field name="rental_vehicle_id"/>
            </field>
        </field>
    </record>

    <record id="maintenance_request_view_list_inherit_rental" model="ir.ui.view">
        <field name="name">maintenance.request.list.rental</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="rental_vehicle_id" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
