<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_rental_pricing_rule_form" model="ir.ui.view">
        <field name="name">car.rental.pricing.rule.form</field>
        <field name="model">car.rental.pricing.rule</field>
        <field name="arch" type="xml">
            <form string="Rental Pricing Rule">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Maun - Mazda Demio 4-7 days"/></h1>
                    </div>
                    <group>
                        <group string="Rule">
                            <field name="vehicle_category_id"/>
                            <field name="destination_id"/>
                            <field name="min_days"/>
                            <field name="max_days"/>
                        </group>
                        <group string="Rate">
                            <field name="daily_rate"/>
                            <field name="currency_id"/>
                            <field name="effective_from"/>
                            <field name="effective_to"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Notes">
                            <field name="notes" nolabel="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rental_pricing_rule_list" model="ir.ui.view">
        <field name="name">car.rental.pricing.rule.list</field>
        <field name="model">car.rental.pricing.rule</field>
        <field name="arch" type="xml">
            <list string="Rental Pricing Rules">
                <field name="name"/>
                <field name="destination_id"/>
                <field name="vehicle_category_id"/>
                <field name="min_days"/>
                <field name="max_days" optional="show"/>
                <field name="daily_rate"/>
                <field name="currency_id" optional="hide"/>
                <field name="effective_from"/>
                <field name="effective_to" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_rental_pricing_rule_search" model="ir.ui.view">
        <field name="name">car.rental.pricing.rule.search</field>
        <field name="model">car.rental.pricing.rule</field>
        <field name="arch" type="xml">
            <search string="Search Pricing Rules">
                <field name="name"/>
                <field name="destination_id"/>
                <field name="vehicle_category_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Destination" name="group_destination" context="{'group_by': 'destination_id'}"/>
                    <filter string="Vehicle Category" name="group_category" context="{'group_by': 'vehicle_category_id'}"/>
                    <filter string="Effective From" name="group_effective" context="{'group_by': 'effective_from'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rental_pricing_rule" model="ir.actions.act_window">
        <field name="name">Rental Pricing Rules</field>
        <field name="res_model">car.rental.pricing.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a pricing rule</p>
            <p>The engine matches company + vehicle category + destination + duration band + effective date. Overlapping active rules are rejected.</p>
        </field>
    </record>
</odoo>
