<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_template_form_view_inherit_rental" model="ir.ui.view">
        <field name="name">product.template.form.rental</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <group name="group_general" position="inside">
                <field name="is_car_rental"/>
                <field name="rental_vehicle_category_id" invisible="not is_car_rental"/>
            </group>
        </field>
    </record>
</odoo>
