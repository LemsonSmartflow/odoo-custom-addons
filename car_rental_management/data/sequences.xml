<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_car_rental_inspection" model="ir.sequence">
        <field name="name">Rental Inspection</field>
        <field name="code">car.rental.inspection</field>
        <field name="prefix">INSP</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_car_rental_damage" model="ir.sequence">
        <field name="name">Damage Assessment</field>
        <field name="code">car.rental.damage</field>
        <field name="prefix">DMG</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_car_rental_deposit" model="ir.sequence">
        <field name="name">Rental Deposit</field>
        <field name="code">car.rental.deposit</field>
        <field name="prefix">DEP</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_car_rental_charge" model="ir.sequence">
        <field name="name">Additional Rental Charge</field>
        <field name="code">car.rental.charge</field>
        <field name="prefix">CHR</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
