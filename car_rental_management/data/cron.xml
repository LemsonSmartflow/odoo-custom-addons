<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_rental_compliance" model="ir.cron">
            <field name="name">Car Rental: Compliance expiry activities (30/60/90 days)</field>
            <field name="model_id" ref="model_fleet_vehicle"/>
            <field name="state">code</field>
            <field name="code">model._cron_rental_compliance()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=4, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <record id="ir_cron_rental_maintenance" model="ir.cron">
            <field name="name">Car Rental: Maintenance threshold requests</field>
            <field name="model_id" ref="model_fleet_vehicle"/>
            <field name="state">code</field>
            <field name="code">model._cron_rental_maintenance()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=4, minute=15) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <record id="ir_cron_rental_overdue" model="ir.cron">
            <field name="name">Car Rental: Overdue rental notifications</field>
            <field name="model_id" ref="model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_rental_overdue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=6, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>
