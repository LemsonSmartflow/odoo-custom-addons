<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="group_car_rental_agent" model="res.groups"><field name="implied_ids" eval="[(4, ref('base.group_partner_manager'))]"/></record>

    <record id="partner_native_rental_details" model="ir.ui.view">
        <field name="name">Contact rental details</field><field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_rental_reservations" type="object" class="oe_stat_button" icon="fa-calendar" string="Reservations" groups="car_rental_management_odoo.group_car_rental_agent"/>
                <button name="action_rental_rentals" type="object" class="oe_stat_button" icon="fa-car" string="Rentals" groups="car_rental_management_odoo.group_car_rental_agent"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Rental Details" name="rental_details" groups="car_rental_management_odoo.group_car_rental_agent">
                    <group><field name="rental_enabled" string="Enable Rentals for This Company"/></group>
                    <div class="alert alert-info">Use the standard contact name, phone, email and street address above. Rental documents below belong to the current company. Drivers must be at least 21 at pickup.</div>
                    <group invisible="not rental_enabled">
                        <group string="Identity and address">
                            <field name="rental_cin" required="rental_enabled"/>
                            <field name="rental_date_of_birth" required="rental_enabled"/>
                            <field name="rental_postal_address" string="Postal Address" required="rental_enabled"/>
                        </group>
                        <group string="Driving licence">
                            <field name="rental_driving_license" required="rental_enabled"/>
                            <field name="rental_license_issue_date" required="rental_enabled"/>
                            <field name="rental_license_expiry" required="rental_enabled"/>
                        </group>
                    </group>
                    <group invisible="not rental_enabled">
                        <group string="Omang"><field name="rental_omang_document_ids" widget="many2many_binary" nolabel="1"/></group>
                        <group string="Passport"><field name="rental_passport_document_ids" widget="many2many_binary" nolabel="1"/></group>
                        <group string="Driving licence"><field name="rental_license_document_ids" widget="many2many_binary" nolabel="1"/></group>
                        <group string="Other / existing documents"><field name="rental_document_ids" widget="many2many_binary" nolabel="1"/></group>
                    </group>
                    <button name="action_rental_book" type="object" string="Create a Booking" class="btn-primary" invisible="not rental_enabled"/>
                </page>
            </xpath>
        </field>
    </record>
    <record id="action_native_customers" model="ir.actions.act_window">
        <field name="name">Customers</field><field name="res_model">res.partner</field><field name="view_mode">kanban,list,form</field>
        <field name="domain">['|', ('company_id', '=', False), ('company_id', '=', allowed_company_ids[0])]</field>
        <field name="context">{'default_is_company': False}</field>
    </record>
    <record id="menu_car_rental_customer" model="ir.ui.menu"><field name="action" ref="action_native_customers"/></record>

    <record id="fleet_native_rental_details" model="ir.ui.view">
        <field name="name">Fleet rental details</field><field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_reservations" type="object" class="oe_stat_button" icon="fa-calendar" groups="car_rental_management_odoo.group_car_rental_agent"><field name="reservation_count" widget="statinfo" string="Reservations"/></button>
                <button name="action_rentals" type="object" class="oe_stat_button" icon="fa-key" groups="car_rental_management_odoo.group_car_rental_agent"><field name="rental_count" widget="statinfo" string="Rentals"/></button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Rental Details" name="rental_details" groups="car_rental_management_odoo.group_fleet_manager">
                    <button name="action_enable_rentals" type="object" string="Enable Rentals" class="btn-primary" invisible="rental_status != 'setup'"/>
                    <group string="Rental setup" name="rental_setup" invisible="rental_status != 'setup'">
                        <field name="rental_category_id"/>
                    </group>
                    <div invisible="rental_status == 'setup'">
                        <group>
                            <group string="Rental setup"><field name="rental_category_id"/><field name="rental_status"/><field name="rental_image" widget="image" class="oe_avatar"/></group>
                            <group string="Service and tracking"><field name="rental_tracker_working"/><field name="rental_service_interval"/><field name="rental_next_service_date"/><field name="rental_next_service_mileage"/><field name="rental_service_due"/><field name="manager_id"/></group>
                        </group>
                        <group>
                            <group string="Insurance and licences (Fleet contracts)">
                                <field name="log_contracts" readonly="1"><list create="1" delete="0"><field name="cost_subtype_id"/><field name="insurer_id"/><field name="ins_ref"/><field name="start_date"/><field name="expiration_date"/><field name="state" widget="badge"/></list></field>
                            </group>
                            <group string="Rental documents"><field name="rental_document_ids" widget="many2many_binary" nolabel="1"/></group>
                        </group>
                        <group string="Rental financials" groups="car_rental_management_odoo.group_rental_manager,car_rental_management_odoo.group_rental_accountant">
                            <field name="currency_id" invisible="1"/>
                            <group><field name="rental_revenue"/><field name="rental_maintenance_cost"/></group>
                        </group>
                        <div class="text-muted">Daily rates are calculated from approved destination pricing rules.</div>
                        <button name="action_rental_activate" type="object" string="Activate for Rental" class="btn-primary" invisible="rental_status != 'setup'"/>
                        <button name="action_rental_cleaning" type="object" string="Start Cleaning" invisible="rental_status not in ['returned', 'inspection']"/>
                        <button name="action_rental_release" type="object" string="Release after Cleaning" class="btn-primary" invisible="rental_status != 'cleaning'"/>
                        <button name="action_rental_maintenance" type="object" string="Rental Maintenance"/>
                        <button name="action_rental_book" type="object" string="New Reservation"/>
                        <button name="action_rental_reservations" type="object" string="Reservations"/>
                        <button name="action_rental_rentals" type="object" string="Rental History"/>
                    </div>
                </page>
                <page string="Reservations" name="rental_reservations_page" groups="car_rental_management_odoo.group_car_rental_agent">
                    <field name="reservation_ids" readonly="1"><list create="0" delete="0"><field name="reference"/><field name="partner_id"/><field name="start_date"/><field name="end_date"/><field name="amount"/><field name="status" widget="badge"/></list></field>
                </page>
                <page string="Rental History" name="rental_history_page" groups="car_rental_management_odoo.group_car_rental_agent">
                    <field name="rental_ids" readonly="1"><list create="0" delete="0"><field name="reference"/><field name="partner_id"/><field name="start_date"/><field name="amount"/><field name="paid_total"/><field name="balance_due"/><field name="status" widget="badge"/></list></field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="action_native_vehicles" model="ir.actions.act_window">
        <field name="name">Vehicles</field><field name="res_model">fleet.vehicle</field><field name="view_mode">kanban,list,form</field>
        <field name="domain">['|', ('company_id', '=', False), ('company_id', '=', allowed_company_ids[0])]</field>
    </record>
    <record id="menu_car_rental_vehicle" model="ir.ui.menu"><field name="action" ref="action_native_vehicles"/></record>

    <record id="rental_read_fleet_vehicle" model="ir.model.access"><field name="name">Rental staff fleet_vehicle</field><field name="model_id" ref="fleet.model_fleet_vehicle"/><field name="group_id" ref="group_car_rental_agent"/><field name="perm_read" eval="True"/><field name="perm_write" eval="True"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/></record>
    <record id="rental_read_fleet_vehicle_model" model="ir.model.access"><field name="name">Rental staff read fleet_vehicle_model</field><field name="model_id" ref="fleet.model_fleet_vehicle_model"/><field name="group_id" ref="group_car_rental_agent"/><field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/></record>
    <record id="rental_read_fleet_vehicle_model_brand" model="ir.model.access"><field name="name">Rental staff read fleet_vehicle_model_brand</field><field name="model_id" ref="fleet.model_fleet_vehicle_model_brand"/><field name="group_id" ref="group_car_rental_agent"/><field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/></record>
    <record id="rental_read_fleet_vehicle_model_category" model="ir.model.access"><field name="name">Rental staff read fleet_vehicle_model_category</field><field name="model_id" ref="fleet.model_fleet_vehicle_model_category"/><field name="group_id" ref="group_car_rental_agent"/><field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/></record>
    <record id="rental_manager_fleet_vehicle_model_category" model="ir.model.access"><field name="name">Rental managers fleet_vehicle_model_category</field><field name="model_id" ref="fleet.model_fleet_vehicle_model_category"/><field name="group_id" ref="group_rental_manager"/><field name="perm_read" eval="True"/><field name="perm_write" eval="True"/><field name="perm_create" eval="True"/><field name="perm_unlink" eval="False"/></record>
    <record id="rental_read_fleet_vehicle_state" model="ir.model.access"><field name="name">Rental staff read fleet_vehicle_state</field><field name="model_id" ref="fleet.model_fleet_vehicle_state"/><field name="group_id" ref="group_car_rental_agent"/><field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/></record>
    <record id="rental_read_fleet_vehicle_tag" model="ir.model.access"><field name="name">Rental staff read fleet_vehicle_tag</field><field name="model_id" ref="fleet.model_fleet_vehicle_tag"/><field name="group_id" ref="group_car_rental_agent"/><field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/></record>
    <record id="rental_read_fleet_vehicle_odometer" model="ir.model.access"><field name="name">Rental staff read fleet_vehicle_odometer</field><field name="model_id" ref="fleet.model_fleet_vehicle_odometer"/><field name="group_id" ref="group_car_rental_agent"/><field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/></record>
    <record id="rental_read_fleet_vehicle_log_contract" model="ir.model.access"><field name="name">Rental staff read fleet_vehicle_log_contract</field><field name="model_id" ref="fleet.model_fleet_vehicle_log_contract"/><field name="group_id" ref="group_car_rental_agent"/><field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/></record>
    <record id="rental_read_fleet_vehicle_log_services" model="ir.model.access"><field name="name">Rental staff read fleet_vehicle_log_services</field><field name="model_id" ref="fleet.model_fleet_vehicle_log_services"/><field name="group_id" ref="group_car_rental_agent"/><field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/></record>
    <record id="rental_read_fleet_service_type" model="ir.model.access"><field name="name">Rental staff read fleet_service_type</field><field name="model_id" ref="fleet.model_fleet_service_type"/><field name="group_id" ref="group_car_rental_agent"/><field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/></record>
    <record id="rental_read_fleet_vehicle_assignation_log" model="ir.model.access"><field name="name">Rental staff read fleet_vehicle_assignation_log</field><field name="model_id" ref="fleet.model_fleet_vehicle_assignation_log"/><field name="group_id" ref="group_car_rental_agent"/><field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/></record>
</odoo>
