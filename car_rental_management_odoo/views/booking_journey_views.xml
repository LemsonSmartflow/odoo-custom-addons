<odoo>
    <record id="access_booking_journey" model="ir.model.access">
        <field name="name">Booking staff</field><field name="model_id" ref="model_car_rental_journey"/>
        <field name="group_id" ref="group_car_rental_agent"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="True"/><field name="perm_create" eval="True"/><field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_booking_journey_company" model="ir.rule">
        <field name="name">Booking company isolation</field><field name="model_id" ref="model_car_rental_journey"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="booking_journey_list" model="ir.ui.view">
        <field name="name">Create a Booking</field><field name="model">car.rental.journey</field>
        <field name="arch" type="xml"><list class="o_car_rental_list" default_order="create_date desc, id desc"><field name="name"/><field name="partner_id"/><field name="pickup_datetime" string="Pickup Date"/><field name="create_date" string="Created On" optional="show"/><field name="vehicle_id"/><field name="step" string="Booking Stage" widget="badge"/></list></field>
    </record>
    <record id="booking_journey_form" model="ir.ui.view">
        <field name="name">Guided booking</field><field name="model">car.rental.journey</field>
        <field name="arch" type="xml">
            <form string="Create a Booking" class="o_car_rental_form">
                <header>
                    <button name="action_back" type="object" string="Back / Review Booking" invisible="step in ['customer', 'closed', 'cancelled']"/>
                    <button name="action_continue" type="object" string="Continue" class="btn-primary" invisible="step in ['closed', 'cancelled', 'handover', 'settlement']"/>
                    <button name="action_continue" type="object" string="Hand Over Vehicle" class="btn-primary" invisible="step != 'handover'" confirm="Confirm the keys and vehicle are being handed to the customer?"/>
                    <button name="action_continue" type="object" string="Close Rental" class="btn-primary" invisible="step != 'settlement'" groups="car_rental_management_odoo.group_rental_accountant"/>
                    <button name="action_cancel" type="object" string="Cancel Booking" invisible="step in ['return', 'settlement', 'closed', 'cancelled']" confirm="Cancel this booking and release its reservation? Existing records will be retained."/>
                    <button name="action_end_early" type="object" string="End Rental Early" invisible="step != 'return'"/>
                    <button name="action_save_exit" type="object" string="Save &amp; Exit"/>
                    <field name="step" widget="statusbar" options="{'clickable': False}" statusbar_visible="customer,details,quote,confirm,agreement,payment,pickup,handover,return,settlement,closed"/>
                </header>
                <sheet>
                    <field name="reservation_id" invisible="1"/><field name="rental_id" invisible="1"/><field name="currency_id" invisible="1"/>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <div class="alert alert-info"><field name="guidance" nolabel="1"/></div>
                    <group string="Customer" invisible="step != 'customer'">
                        <field name="company_id" readonly="reservation_id"/>
                        <field name="partner_id" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]" context="{'default_company_id': company_id}" options="{'no_quick_create': True}"/>
                        <button name="action_customer" type="object" string="Review Customer Documents" invisible="not partner_id"/>
                    </group>
                    <group string="Booking details" invisible="step != 'details'">
                        <field name="destination_id" domain="[('company_id', '=', company_id)]"/>
                        <field name="category_id"/>
                        <field name="pickup_datetime"/>
                        <field name="number_of_days" string="Rental Days (24-hour periods)" required="1"/>
                        <field name="expected_return_datetime" readonly="1"/>
                        <field name="vehicle_id" domain="[('company_id', '=', company_id), ('rental_category_id', '=', category_id), ('rental_status', 'in', ['available', 'reserved', 'rented'])]"/>
                        <div colspan="2" class="text-muted">Leave vehicle empty to allocate an available vehicle automatically. Availability is checked against both pickup and return times.</div>
                    </group>
                    <group string="Booking summary" invisible="step in ['customer', 'details']">
                        <field name="partner_id" readonly="1"/><field name="vehicle_id" readonly="1"/>
                        <field name="destination_id" readonly="1"/><field name="pickup_datetime" readonly="1"/><field name="expected_return_datetime" readonly="1"/>
                        <field name="number_of_days" string="24-hour Rental Days" readonly="1"/><field name="amount" string="Hire Total" widget="monetary"/>
                        <field name="deposit_required" string="Refundable Security Deposit"/>
                        <field name="customer_deposit_credit" string="Customer Deposit Credit Available"/>
                        <field name="cleaning_fee" string="One-time Fee if Returned Dirty"/>
                    </group>
                    <field name="vehicle_image" widget="image" class="oe_avatar" invisible="not vehicle_id"/>
                    <group string="Agreement" invisible="step != 'agreement'">
                        <button name="action_agreement" type="object" string="Prepare / Review Agreement" class="btn-primary"/>
                        <div colspan="2">Complete the agreement first. After it is signed, return here and click Continue to proceed to payment.</div>
                    </group>
                    <group string="Payment and security deposit" invisible="step != 'payment'">
                        <field name="customer_deposit_credit" string="Prior Deposit Credit Available"/>
                        <button name="action_invoice" type="object" string="1. Create / Open Rental Invoice" groups="car_rental_management_odoo.group_rental_accountant"/>
                        <button name="action_payment" type="object" string="2. Record Rental Payment" groups="car_rental_management_odoo.group_rental_accountant"/>
                        <button name="action_deposit" type="object" string="3. Collect Security Deposit" groups="car_rental_management_odoo.group_rental_accountant"/>
                        <div colspan="2">Prior refundable deposit credit from the customer's settled returns is shown above and will be applied by default during collection. An accountant can adjust the amount, then post any remaining cash deposit and rental payment. Return here and click Continue to refresh progress.</div>
                    </group>
                    <group string="Vehicle inspections" invisible="step not in ['pickup', 'handover', 'return']">
                        <button name="action_rental" type="object" string="Review Rental"/>
                        <button name="action_inspection" type="object" string="Open / Complete Inspection"/>
                    </group>
                    <group string="Settlement" invisible="step != 'settlement'">
                        <button name="action_rental" type="object" string="Open Charges, Invoices and Deposit Refund"/>
                        <div colspan="2">Post applicable late, cleaning and damage invoices. Apply approved deposit deductions, settle outstanding amounts and refund the remainder before closing.</div>
                    </group>
                    <group string="Linked records" invisible="not reservation_id">
                        <button name="action_reservation" type="object" string="Reservation"/>
                        <button name="action_rental" type="object" string="Rental and Payments" invisible="not rental_id"/>
                        <button name="action_vehicle" type="object" string="Vehicle / Fleet Follow-up"/>
                    </group>
                </sheet><chatter/>
            </form>
        </field>
    </record>
    <record id="action_booking_journeys" model="ir.actions.act_window">
        <field name="name">Create a Booking</field><field name="res_model">car.rental.journey</field><field name="view_mode">list,form</field>
        <field name="domain">[('company_id', '=', allowed_company_ids[0])]</field>
    </record>
    <record id="booking_journey_search" model="ir.ui.view">
        <field name="name">Booking workspace search</field><field name="model">car.rental.journey</field>
        <field name="arch" type="xml"><search string="Search Bookings"><field name="name"/><field name="partner_id"/><field name="vehicle_id"/><field name="pickup_datetime"/><filter name="confirmed" string="Confirmed Reservation" domain="[('reservation_id.status', '=', 'confirmed')]"/><filter name="cancelled" string="Cancelled Reservation" domain="[('reservation_id.status', '=', 'cancelled')]"/><filter name="by_pickup_month" string="Pickup Month" context="{'group_by': 'pickup_datetime:month'}"/><filter name="by_creation_month" string="Created Month" context="{'group_by': 'create_date:month'}"/></search></field>
    </record>
    <record id="action_booking_journeys" model="ir.actions.act_window">
        <field name="search_view_id" ref="booking_journey_search"/>
    </record>
    <menuitem id="menu_booking_journeys" name="Create a Booking" parent="menu_rental_bookings" action="action_booking_journeys" sequence="1"/>
    <record id="reservation_journey_button" model="ir.ui.view">
        <field name="name">Reservation booking</field><field name="model">car.rental.reservation</field><field name="inherit_id" ref="view_car_rental_reservation_form"/>
        <field name="priority">100</field><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_booking_journey" type="object" string="Open Booking"/></xpath></field>
    </record>
    <record id="rental_journey_button" model="ir.ui.view">
        <field name="name">Rental booking</field><field name="model">car.rental.rental</field><field name="inherit_id" ref="view_car_rental_rental_form"/>
        <field name="priority">100</field><field name="arch" type="xml">
            <xpath expr="//header" position="inside"><button name="action_booking_journey" type="object" string="Open Booking"/></xpath>
            <xpath expr="//header/field[@name='status']" position="attributes"><attribute name="statusbar_visible">draft,ongoing,returned,closed</attribute></xpath>
        </field>
    </record>
</odoo>
