<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <menuitem id="menu_rental_bookings" name="Bookings" parent="menu_car_rental_root" sequence="20"/>
    <menuitem id="menu_rental_fleet" name="Fleet" parent="menu_car_rental_root" sequence="30"/>
    <menuitem id="menu_rental_payments_root" name="Payments" parent="menu_car_rental_root" sequence="40"/>

    <record id="menu_car_rental_reservation" model="ir.ui.menu">
        <field name="parent_id" ref="menu_rental_bookings"/>
        <field name="sequence">10</field>
    </record>
    <record id="menu_car_rental_rental" model="ir.ui.menu">
        <field name="parent_id" ref="menu_rental_bookings"/>
        <field name="sequence">20</field>
    </record>
    <record id="menu_car_rental_vehicle" model="ir.ui.menu">
        <field name="parent_id" ref="menu_rental_fleet"/>
        <field name="sequence">10</field>
    </record>
    <record id="menu_rental_inspections" model="ir.ui.menu">
        <field name="parent_id" ref="menu_rental_fleet"/>
        <field name="sequence">20</field>
    </record>
    <record id="menu_rental_damage" model="ir.ui.menu">
        <field name="parent_id" ref="menu_rental_fleet"/>
        <field name="sequence">30</field>
    </record>
    <record id="menu_rental_service" model="ir.ui.menu">
        <field name="parent_id" ref="menu_rental_fleet"/>
        <field name="sequence">40</field>
    </record>
    <record id="menu_car_rental_payment" model="ir.ui.menu">
        <field name="name">Receipts</field>
        <field name="parent_id" ref="menu_rental_payments_root"/>
        <field name="sequence">10</field>
    </record>
    <record id="menu_rental_deposits" model="ir.ui.menu">
        <field name="name">Deposits &amp; Refunds</field>
        <field name="parent_id" ref="menu_rental_payments_root"/>
        <field name="sequence">30</field>
    </record>

    <record id="action_rental_billing" model="ir.actions.act_window">
        <field name="name">Rental Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('car_rental_id', '!=', False), ('move_type', 'in', ['out_invoice', 'out_refund'])]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'create': False}</field>
    </record>
    <record id="action_rental_outstanding" model="ir.actions.act_window">
        <field name="name">Outstanding Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('car_rental_id', '!=', False), ('move_type', '=', 'out_invoice'), ('state', '=', 'posted'), ('amount_residual', '&gt;', 0)]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'create': False}</field>
    </record>
    <menuitem id="menu_rental_billing" name="Invoices" parent="menu_rental_payments_root" action="action_rental_billing" sequence="20" groups="car_rental_management_odoo.group_rental_accountant"/>
    <menuitem id="menu_rental_outstanding" name="Outstanding Invoices" parent="menu_rental_payments_root" action="action_rental_outstanding" sequence="40" groups="car_rental_management_odoo.group_rental_accountant"/>
</odoo>
