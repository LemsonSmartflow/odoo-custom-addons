<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_rate_list" model="ir.ui.view"><field name="name">rental.rate.list</field><field name="model">car.rental.rate.rule</field><field name="arch" type="xml"><list decoration-muted="state == 'draft'"><field name="name"/><field name="destination_id"/><field name="category_id"/><field name="min_days"/><field name="max_days"/><field name="currency_id" column_invisible="1"/><field name="daily_rate"/><field name="deposit_amount"/><field name="date_from"/><field name="date_to"/><field name="sequence"/><field name="state" widget="badge" decoration-success="state == 'approved'"/><field name="cleaning_fee" string="Dirty Return Fee"/></list></field></record>
    <record id="view_rate_form" model="ir.ui.view"><field name="name">rental.rate.form</field><field name="model">car.rental.rate.rule</field><field name="arch" type="xml"><form class="o_car_rental_form"><header><button name="action_approve" string="Approve Rate" type="object" class="btn-primary" invisible="state != 'draft'" groups="car_rental_management_odoo.group_rental_manager"/><button name="action_draft" string="Return to Draft" type="object" invisible="state == 'draft'" groups="car_rental_management_odoo.group_rental_manager"/><field name="state" widget="statusbar"/></header><sheet>
 <field name="currency_id" invisible="1"/>
 <div class="oe_title"><h1><field name="name" placeholder="e.g. Maun ? Mazda Demio" readonly="state == 'approved'"/></h1></div>
 <group col="1">
  <group string="Where this rule applies" col="2"><field name="company_id" groups="base.group_multi_company" readonly="state == 'approved'"/><field name="destination_id" readonly="state == 'approved'"/><field name="category_id" readonly="state == 'approved'"/></group>
  <group string="Rental duration and validity" col="2"><field name="min_days" string="Minimum Rental Days" readonly="state == 'approved'"/><field name="max_days" string="Maximum Days (0 = no limit)" readonly="state == 'approved'"/><field name="date_from" string="Valid From" readonly="state == 'approved'"/><field name="date_to" string="Valid Until" readonly="state == 'approved'"/></group>
 </group>
 <separator string="Hire price and refundable deposit"/>
 <group col="1">
  <group string="Hire price" col="2"><field name="daily_rate" string="Rate per 24-hour Day" readonly="state == 'approved'"/><div class="text-muted" colspan="2">Each started 24-hour rental period is billed at this rate.</div></group>
  <group string="Refundable security deposit" col="2"><field name="deposit_amount" string="Security Deposit Amount" readonly="state == 'approved'"/><div class="text-muted" colspan="2">Held separately from the hire price. Defaults to one daily rate; you can set 50?100% of that rate. Refund the balance after settling return charges.</div></group>
 </group>
 <separator string="Additional charge ? only for a dirty return"/>
 <group col="1">
  <group string="Cleaning charge" col="2"><field name="cleaning_fee" string="One-time Dirty Return Fee" readonly="state == 'approved'"/><div class="text-muted" colspan="2">Charged once per rental when the return inspection says Clean: No. This is not a daily fee. Finance can settle its posted invoice from the security deposit.</div></group>
  <group string="Rule selection and approval" col="2"><field name="sequence" string="Priority (lowest number first)" readonly="state == 'approved'"/><field name="approved_by"/><div class="text-muted" colspan="2">When several approved rules match, the lowest priority number wins.</div></group>
 </group>
 <separator string="Internal pricing notes"/>
 <field name="notes" nolabel="1" readonly="state == 'approved'" placeholder="Explain any special rate conditions or approval notes."/>
 <div class="alert alert-warning mt-3" invisible="state != 'draft'" role="status">Save and approve this rule before it can price confirmed reservations.</div>
</sheet><chatter/></form></field></record>
    <record id="action_rates" model="ir.actions.act_window"><field name="name">Pricing Rules</field><field name="res_model">car.rental.rate.rule</field><field name="view_mode">list,form</field></record>
    <record id="action_zones" model="ir.actions.act_window"><field name="name">Destinations</field><field name="res_model">car.rental.zone</field><field name="view_mode">list,form</field></record>
    <record id="action_categories" model="ir.actions.act_window"><field name="name">Vehicle Categories</field><field name="res_model">car.rental.category</field><field name="view_mode">list,form</field></record>

    <record id="vehicle_form_proposal" model="ir.ui.view"><field name="name">rental.vehicle.proposal</field><field name="model">car.rental.vehicle</field><field name="inherit_id" ref="vehicle_form_connected"/><field name="arch" type="xml">
        <xpath expr="//header" position="inside"><button name="action_activate" type="object" string="Activate Vehicle" class="btn-primary" invisible="status != 'setup'" groups="car_rental_management_odoo.group_fleet_manager"/><button name="action_mark_cleaning" type="object" string="Send to Cleaning" invisible="status not in ['inspection', 'returned']" groups="car_rental_management_odoo.group_fleet_manager"/><button name="action_release" type="object" string="Release Vehicle" invisible="status != 'cleaning'" groups="car_rental_management_odoo.group_fleet_manager"/></xpath>
        <xpath expr="//header/button[@name='action_book']" position="attributes"><attribute name="invisible">status not in ['available', 'reserved', 'rented']</attribute></xpath>
        <xpath expr="//sheet/div[@name='button_box']" position="inside"><button name="action_sync_fleet" type="object" class="oe_stat_button" icon="fa-car" groups="car_rental_management_odoo.group_fleet_manager"><div class="o_stat_info"><span class="o_stat_text">Odoo Fleet</span></div></button><button name="action_maintenance" type="object" class="oe_stat_button" icon="fa-wrench" groups="car_rental_management_odoo.group_fleet_manager"><div class="o_stat_info"><span class="o_stat_text">Maintenance</span></div></button></xpath>
        <field name="registration_number" position="before"><div class="text-muted"><field name="fleet_id" placeholder="Fleet ID"/></div></field>
        <field name="category" position="replace"><field name="category_id"/><field name="vin"/></field>
        <xpath expr="//notebook" position="inside"><page string="Compliance &amp; Service"><group col="1"><group string="Insurance"><field name="insurance_provider"/><field name="insurance_policy"/><field name="insurance_expiry"/></group><group string="Licensing &amp; fitness"><field name="road_license_number"/><field name="road_license_expiry"/><field name="tracker_working"/></group></group><group string="Service schedule"><field name="service_interval"/><field name="next_service_mileage"/><field name="next_service_date"/><field name="service_due"/><field name="responsible_id"/></group></page><page string="Documents"><field name="document_ids" widget="many2many_binary"/></page><page string="Financial History" groups="car_rental_management_odoo.group_rental_manager,car_rental_management_odoo.group_rental_accountant"><field name="currency_id" invisible="1"/><group><field name="rental_revenue"/><field name="maintenance_cost"/></group></page></xpath>
        <xpath expr="//form" position="inside"><chatter/></xpath>
    <xpath expr="//field[@name='daily_price']" position="replace"><div class="text-muted">Daily rates are calculated from approved destination pricing rules.</div></xpath></field></record>
    <record id="vehicle_gallery_proposal" model="ir.ui.view"><field name="name">rental.vehicle.gallery.proposal</field><field name="model">car.rental.vehicle</field><field name="inherit_id" ref="vehicle_gallery"/><field name="arch" type="xml"><field name="registration_number" position="before"><field name="fleet_id"/> · </field><xpath expr="//button[@name='action_book']" position="attributes"><attribute name="invisible">status not in ['available', 'reserved', 'rented']</attribute></xpath><field name="daily_price" position="replace"><span class="text-muted">Destination pricing</span></field><xpath expr="//span[hasclass('text-muted') and contains(text(), '/ day')]" position="replace"/></field></record>

    <record id="reservation_form_proposal" model="ir.ui.view"><field name="name">rental.reservation.proposal</field><field name="model">car.rental.reservation</field><field name="inherit_id" ref="reservation_form_connected"/><field name="arch" type="xml"><xpath expr="//form" position="replace">
        <form string="Reservation" class="o_car_rental_form"><header><button name="action_reprice" string="Calculate Price" type="object" invisible="status != 'draft'"/><button name="action_allocate" string="Allocate Vehicle" type="object" invisible="status != 'draft'"/><button name="action_confirm" string="Confirm Reservation" type="object" class="btn-primary" invisible="status != 'draft'"/><button name="action_create_rental" string="Create Rental" type="object" class="btn-primary" invisible="status != 'confirmed' or rental_count &gt; 0"/><button name="action_cancel" string="Cancel" type="object" invisible="status == 'cancelled' or rental_count &gt; 0"/><field name="status" widget="statusbar"/></header><sheet><field name="currency_id" invisible="1"/><field name="available_vehicle_ids" invisible="1"/><div class="oe_button_box" name="button_box"><button name="action_rentals" type="object" class="oe_stat_button" icon="fa-key" invisible="rental_count == 0"><field name="rental_count" widget="statinfo" string="Rental"/></button></div><div class="oe_title"><div class="text-muted">DESTINATION RENTAL BOOKING</div><h1><field name="reference" readonly="0" required="0" placeholder="Generated on save, or enter your reference"/></h1></div><div class="alert alert-info" role="status"><field name="pricing_note" nolabel="1"/></div>
            <group col="1"><group string="Customer &amp; destination"><field name="company_id" groups="base.group_multi_company" readonly="status != 'draft'"/><field name="customer_id" readonly="status != 'draft'"/><field name="destination_id" readonly="status != 'draft'"/><field name="category_id" readonly="status != 'draft'"/><field name="vehicle_id" domain="[('id', 'in', available_vehicle_ids)]" readonly="status != 'draft'" options="{'no_create': True}"/><field name="vehicle_image" widget="image" nolabel="1" options="{'size': [320, 180]}"/></group><group string="Rental dates"><field name="pickup_datetime" readonly="status != 'draft'" string="Pickup Date and Time" required="1"/><field name="expected_return_datetime" readonly="status != 'draft'" string="Return Date and Time" required="1"/><field name="number_of_days" string="24-hour Rental Days"/></group></group>
            <notebook><page string="Quote &amp; Deposit"><group col="1"><group string="Agreed price"><field name="pricing_rule_id"/><field name="standard_daily_rate"/><field name="quoted_daily_rate"/><field name="amount_untaxed"/><field name="tax_id"/><field name="tax_amount"/><field name="amount"/></group><group string="Security deposit"><field name="deposit_required"/><div class="text-muted">The deposit is held separately as a customer liability. It is not rental revenue.</div><field name="cleaning_fee" string="One-time Fee if Returned Dirty"/></group></group></page><page string="Price Override"><group><field name="override_state"/><field name="proposed_rate" readonly="status != 'draft' or override_state == 'approved'"/><field name="override_reason" readonly="status != 'draft' or override_state == 'approved'"/><field name="override_approved_by"/><field name="override_approved_on"/></group><button name="action_request_override" string="Request Approval" type="object" invisible="status != 'draft' or override_state == 'approved'"/><button name="action_approve_override" string="Approve Override" type="object" class="btn-primary" invisible="override_state != 'pending'" groups="car_rental_management_odoo.group_rental_manager"/></page></notebook>
        </sheet><chatter/></form>
    </xpath></field></record>

    <record id="rental_form_proposal" model="ir.ui.view"><field name="name">rental.form.proposal</field><field name="model">car.rental.rental</field><field name="inherit_id" ref="rental_form_connected"/><field name="arch" type="xml">
        <xpath expr="//header" position="inside"><button name="action_pickup_inspection" type="object" string="Pickup Inspection" invisible="status != 'draft'"/><button name="action_return_inspection" type="object" string="Return Inspection" invisible="status != 'ongoing'"/><button name="action_print_agreement" type="object" string="Print Agreement"/><button name="action_invoice" type="object" string="Create / Open Invoice" groups="car_rental_management_odoo.group_rental_accountant"/><button name="action_quotation" type="object" string="Sales Quotation" groups="car_rental_management_odoo.group_rental_manager"/></xpath>
        <xpath expr="//button[@name='action_record_payment']" position="attributes"><attribute name="groups">car_rental_management_odoo.group_rental_accountant</attribute></xpath>
        <xpath expr="//sheet/div[@name='button_box']" position="inside"><button name="action_inspections" type="object" class="oe_stat_button" icon="fa-check-square-o"><div class="o_stat_info"><span class="o_stat_text">Inspections</span></div></button><button name="action_invoices" type="object" class="oe_stat_button" icon="fa-file-text-o" groups="car_rental_management_odoo.group_rental_accountant"><field name="invoice_count" widget="statinfo" string="Invoices"/></button><button name="action_deposits" type="object" class="oe_stat_button" icon="fa-shield" groups="car_rental_management_odoo.group_rental_accountant"><div class="o_stat_info"><span class="o_stat_text">Deposits</span></div></button></xpath>
        <field name="start_date" position="before"><field name="destination_id"/></field>
        <field name="balance_due" position="after"><field name="financial_balance" groups="car_rental_management_odoo.group_rental_accountant,car_rental_management_odoo.group_rental_manager"/><field name="deposit_required"/><field name="deposit_held"/><field name="pickup_inspection_done"/><field name="return_inspection_done"/></field>
        <xpath expr="//notebook" position="inside">
            <page string="Agreement"><group><field name="agreement_state"/><field name="agreement_signed_by" readonly="agreement_state == 'signed'"/><field name="agreement_signed_on"/></group><field name="agreement_terms" readonly="agreement_state == 'signed'" placeholder="Configure the approved agreement terms in Car Rental Settings."/><field name="agreement_signature" widget="signature" readonly="agreement_state == 'signed'"/><button name="action_sign_agreement" string="Acknowledge Agreement" type="object" class="btn-primary" invisible="agreement_state == 'signed'"/></page>
            <page string="Inspections &amp; Damage"><field name="inspection_ids" readonly="1"><list create="0" delete="0"><field name="kind"/><field name="checked_on"/><field name="inspector_id"/><field name="mileage"/><field name="fuel_level"/><field name="new_damage"/><field name="state" widget="badge"/></list></field><separator string="Damage assessments"/><field name="damage_ids" readonly="1"><list create="0" delete="0"><field name="name"/><field name="cost"/><field name="deposit_retained"/><field name="additional_charge"/><field name="state" widget="badge"/></list></field></page>
            <page string="Documents"><field name="document_ids" widget="many2many_binary"/></page>
        </xpath>
        <xpath expr="//form" position="inside"><chatter/></xpath>
    <xpath expr="//page[@name='payments']" position="inside"><separator string="Security Deposit"/><field name="currency_id" invisible="1"/><group><field name="deposit_required"/><field name="deposit_collected"/><field name="deposit_retained"/><field name="deposit_refunded"/><field name="deposit_held"/></group><button name="action_collect_deposit" type="object" string="Collect Deposit" class="btn-primary" invisible="status != 'draft' or deposit_collected &gt;= deposit_required" groups="car_rental_management_odoo.group_rental_accountant"/><button name="action_refund_deposit" type="object" string="Refund Remaining Deposit" invisible="status != 'returned' or deposit_held &lt;= 0" groups="car_rental_management_odoo.group_rental_accountant"/><field name="deposit_transaction_ids" readonly="1"><list create="0" delete="0"><field name="date"/><field name="kind"/><field name="amount"/><field name="state" widget="badge"/></list></field><separator string="Return Charges"/><group><field name="actual_pickup_datetime"/><field name="expected_return_datetime"/><field name="actual_return_datetime"/><field name="late_days"/><field name="late_charge"/></group><button name="action_late_invoice" string="Create / Open Late Return Invoice" type="object" invisible="late_charge &lt;= 0" groups="car_rental_management_odoo.group_rental_accountant"/><separator string="Dirty Return Cleaning"/><group><field name="cleaning_charge" string="Cleaning Charge Billed"/></group><button name="action_cleaning_invoice" string="Open Cleaning Invoice" type="object" invisible="cleaning_charge &lt;= 0" groups="car_rental_management_odoo.group_rental_accountant"/><button name="action_apply_cleaning_deposit" string="Apply Deposit to Cleaning" type="object" invisible="cleaning_charge &lt;= 0" groups="car_rental_management_odoo.group_rental_accountant"/></xpath></field></record>

    <record id="payment_form_proposal" model="ir.ui.view"><field name="name">rental.payment.proposal</field><field name="model">car.rental.payment</field><field name="inherit_id" ref="payment_form_connected"/><field name="arch" type="xml"><xpath expr="//sheet" position="before"><header><button name="action_post_receipt" string="Post Receipt" type="object" class="btn-primary" invisible="ledger_state != 'draft'" groups="car_rental_management_odoo.group_rental_accountant"/><button name="action_account_move" string="Journal Entry" type="object" invisible="not account_move_id" groups="car_rental_management_odoo.group_rental_accountant"/><field name="ledger_state" widget="statusbar"/></header></xpath><field name="rental_id" position="attributes"><attribute name="readonly">ledger_state != 'draft'</attribute></field><field name="paid_amount" position="attributes"><attribute name="readonly">ledger_state != 'draft'</attribute></field><field name="payment_date" position="attributes"><attribute name="readonly">ledger_state != 'draft'</attribute></field><field name="payment_method" position="attributes"><attribute name="readonly">ledger_state != 'draft'</attribute></field><field name="remaining_amount" position="after"><field name="account_move_id"/></field><xpath expr="//div[hasclass('alert', 'alert-info')]" position="replace"><div class="alert alert-info" role="status">A draft receipt does not reduce the rental balance. Post Receipt records the bank/cash entry and reconciles the posted rental invoice. Historical receipts remain labelled unposted.</div></xpath><xpath expr="//form" position="inside"><chatter/></xpath></field></record>
    <record id="payment_list_proposal" model="ir.ui.view"><field name="name">rental.payment.list.proposal</field><field name="model">car.rental.payment</field><field name="inherit_id" ref="view_car_rental_payment_list"/><field name="arch" type="xml"><field name="status" position="after"><field name="ledger_state" widget="badge"/></field></field></record>
    <record id="customer_documents" model="ir.ui.view"><field name="name">rental.customer.documents</field><field name="model">car.rental.customer</field><field name="inherit_id" ref="customer_form_connected"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><notebook><page string="Omang"><p>Upload this document here. A booking needs either Omang or passport, plus a driving licence.</p><field name="omang_document_ids" widget="many2many_binary"/></page><page string="Passport"><p>Upload this document here. A booking needs either Omang or passport, plus a driving licence.</p><field name="passport_document_ids" widget="many2many_binary"/></page><page string="Driving Licence"><p>Upload this document here. A booking needs either Omang or passport, plus a driving licence.</p><field name="license_document_ids" widget="many2many_binary"/></page><page string="Previous Documents" invisible="not document_ids"><p>Existing attachments are retained here. Sort them into the relevant document sections.</p><field name="document_ids" widget="many2many_binary"/></page></notebook><group><field name="partner_id" groups="car_rental_management_odoo.group_rental_accountant"/></group></xpath><xpath expr="//form" position="inside"><chatter/></xpath></field></record>

    <record id="view_inspection_list" model="ir.ui.view"><field name="name">rental.check.list</field><field name="model">car.rental.check</field><field name="arch" type="xml"><list><field name="rental_id"/><field name="vehicle_id"/><field name="kind"/><field name="checked_on"/><field name="mileage"/><field name="inspector_id"/><field name="new_damage"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_inspection_form" model="ir.ui.view"><field name="name">rental.check.form</field><field name="model">car.rental.check</field><field name="arch" type="xml"><form class="o_car_rental_form"><header><button name="action_complete" type="object" string="Complete Inspection" class="btn-primary" invisible="state != 'draft'"/><field name="state" widget="statusbar"/></header><sheet><h1>Vehicle condition inspection</h1><group col="1"><group><field name="rental_id" readonly="state == 'done'"/><field name="vehicle_id"/><field name="kind" readonly="state == 'done'"/><field name="checked_on" readonly="state == 'done'"/><field name="inspector_id" readonly="state == 'done'"/></group><group><field name="mileage" readonly="state == 'done'"/><field name="fuel_level" readonly="state == 'done'"/><field name="clean" readonly="state == 'done'"/><field name="new_damage" readonly="state == 'done'"/></group></group><notebook><page string="Condition Checklist"><group><field name="exterior" readonly="state == 'done'"/><field name="interior" readonly="state == 'done'"/><field name="tyres" readonly="state == 'done'"/><field name="accessories" readonly="state == 'done'"/><field name="existing_damage" readonly="state == 'done'"/><field name="damage_notes" readonly="state == 'done'" invisible="not new_damage"/></group></page><page string="Compare Pickup" invisible="kind != 'return'"><group><field name="pickup_check_id"/><field name="pickup_fuel"/><field name="pickup_exterior"/><field name="pickup_interior"/><field name="pickup_existing_damage"/></group></page><page string="Photos &amp; Acknowledgement"><field name="photo_ids" widget="many2many_binary" readonly="state == 'done'"/><group string="Customer Acknowledgement"><field name="acknowledged_by" string="Customer Name (Acknowledged By)" placeholder="Enter the name of the customer signing below" readonly="state == 'done'"/></group><separator string="Customer Signature"/><field name="signature" widget="signature" readonly="state == 'done'"/></page></notebook></sheet><chatter/></form></field></record>
    <record id="action_inspections" model="ir.actions.act_window"><field name="name">Pickup &amp; Return Inspections</field><field name="res_model">car.rental.check</field><field name="view_mode">list,form</field></record>

    <record id="view_damage_list" model="ir.ui.view"><field name="name">rental.damage.list</field><field name="model">car.rental.damage.case</field><field name="arch" type="xml"><list><field name="name"/><field name="rental_id"/><field name="vehicle_id"/><field name="cost"/><field name="deposit_retained"/><field name="additional_charge"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_damage_form" model="ir.ui.view"><field name="name">rental.damage.form</field><field name="model">car.rental.damage.case</field><field name="arch" type="xml"><form class="o_car_rental_form"><header><button name="action_approve" string="Approve Charge" type="object" class="btn-primary" invisible="state != 'draft'" groups="car_rental_management_odoo.group_rental_manager"/><button name="action_repair" string="Request Repair" type="object" invisible="state != 'approved'" groups="car_rental_management_odoo.group_fleet_manager"/><button name="action_invoice" string="Damage Invoice" type="object" invisible="state == 'draft' or cost &lt;= 0" groups="car_rental_management_odoo.group_rental_accountant"/><button name="action_retain_deposit" string="Apply Deposit" type="object" invisible="state == 'draft' or cost &lt;= 0" groups="car_rental_management_odoo.group_rental_accountant"/><button name="action_close" string="Resolve Damage" type="object" invisible="state not in ['approved', 'repair']" groups="car_rental_management_odoo.group_fleet_manager"/><field name="state" widget="statusbar"/></header><sheet><field name="currency_id" invisible="1"/><h1><field name="name"/></h1><group col="1"><group><field name="rental_id" readonly="state != 'draft'"/><field name="vehicle_id"/><field name="inspection_id" readonly="state != 'draft'"/><field name="cost" readonly="state != 'draft'"/></group><group><field name="deposit_retained"/><field name="additional_charge"/><field name="invoice_id" groups="car_rental_management_odoo.group_rental_accountant"/><field name="maintenance_id"/></group></group><field name="repair_notes" placeholder="Record repair work or the reason no repair is needed."/></sheet><chatter/></form></field></record>
    <record id="action_damage" model="ir.actions.act_window"><field name="name">Damage Assessments</field><field name="res_model">car.rental.damage.case</field><field name="view_mode">list,form</field></record>

    <record id="view_deposit_list" model="ir.ui.view"><field name="name">rental.deposit.list</field><field name="model">car.rental.deposit.transaction</field><field name="arch" type="xml"><list><field name="rental_id"/><field name="date"/><field name="kind"/><field name="amount"/><field name="state" widget="badge"/><field name="account_move_id"/></list></field></record>
    <record id="view_deposit_form" model="ir.ui.view"><field name="name">rental.deposit.form</field><field name="model">car.rental.deposit.transaction</field><field name="arch" type="xml"><form class="o_car_rental_form"><header><button name="action_post" string="Post Deposit Transaction" type="object" class="btn-primary" invisible="state != 'draft'" groups="car_rental_management_odoo.group_rental_accountant"/><field name="state" widget="statusbar"/></header><sheet><field name="currency_id" invisible="1"/><h1>Security deposit</h1><group><field name="rental_id" readonly="state == 'posted'"/><field name="kind" readonly="state == 'posted'"/><field name="amount" readonly="state == 'posted'"/><field name="date" readonly="state == 'posted'"/><field name="damage_id" domain="[('rental_id', '=', rental_id)]" invisible="kind != 'retain'" required="kind == 'retain' and not charge_invoice_id" readonly="state == 'posted'"/><field name="account_move_id"/><field name="charge_invoice_id" domain="[('car_rental_id', '=', rental_id), ('rental_invoice_kind', '=', 'cleaning'), ('state', '=', 'posted')]" invisible="kind != 'retain' or damage_id" required="kind == 'retain' and not damage_id" readonly="state == 'posted'"/></group><div class="alert alert-info" role="status">Deposit collection credits the liability account. Refunds debit it. Damage retention settles a separately posted damage invoice.</div></sheet><chatter/></form></field></record>
    <record id="action_deposits" model="ir.actions.act_window"><field name="name">Security Deposits</field><field name="res_model">car.rental.deposit.transaction</field><field name="view_mode">list,form</field></record>

    <record id="maintenance_rental_fields" model="ir.ui.view"><field name="name">maintenance.rental.details</field><field name="model">maintenance.request</field><field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Rental Vehicle Service" col="1"><field name="rental_currency_id" invisible="1"/><group><field name="rental_vehicle_id"/><field name="rental_supplier_id"/><field name="rental_mileage"/><field name="rental_cost"/><field name="rental_bill_id" groups="car_rental_management_odoo.group_rental_accountant"/></group><group><field name="rental_work"/><field name="rental_parts"/><field name="rental_labour"/><field name="rental_warranty_until"/><field name="rental_next_service_date"/><field name="rental_next_service_mileage"/></group></group><button name="action_complete_rental_service" string="Complete Vehicle Service" type="object" class="btn-primary" invisible="not rental_vehicle_id" groups="car_rental_management_odoo.group_fleet_manager"/><button name="action_rental_bill" string="Create / Open Supplier Bill" type="object" invisible="not rental_vehicle_id" groups="car_rental_management_odoo.group_rental_accountant"/></xpath></field></record>
    <record id="action_rental_maintenance" model="ir.actions.act_window"><field name="name">Fleet Maintenance</field><field name="res_model">maintenance.request</field><field name="view_mode">list,form</field><field name="domain">[('rental_vehicle_id', '!=', False)]</field></record>

    <record id="rental_settings_view" model="ir.ui.view"><field name="name">car.rental.settings</field><field name="model">res.config.settings</field><field name="inherit_id" ref="base.res_config_settings_view_form"/><field name="arch" type="xml"><xpath expr="//form" position="inside"><app string="Car Rental" name="car_rental_management_odoo" groups="base.group_system"><block title="Accounting Configuration"><setting string="Rental and recovery accounts"><group><field name="cr_income_account_id" domain="[('company_ids', 'in', [company_id])] + ([('account_type', 'in', ['income', 'income_other'])])"/><field name="cr_damage_account_id" domain="[('company_ids', 'in', [company_id])] + ([('account_type', 'in', ['income', 'income_other'])])"/><field name="cr_deposit_account_id" domain="[('company_ids', 'in', [company_id])] + ([('account_type', '=', 'liability_current')])"/><field name="cr_expense_account_id" domain="[('company_ids', 'in', [company_id])] + ([])"/></group></setting><setting string="Journals, service product and tax"><group><field name="cr_cash_journal_id" domain="[('type', 'in', ['cash', 'bank']), ('company_id', '=', company_id)]"/><field name="cr_sales_journal_id" domain="[('type', '=', 'sale'), ('company_id', '=', company_id)]"/><field name="cr_rental_product_id"/><field name="cr_tax_id" domain="[('type_tax_use', '=', 'sale'), ('company_id', '=', company_id)]"/></group></setting></block><block title="Handover Policy"><setting string="Require rental payment before pickup"><field name="rental_require_full_payment"/></setting><setting string="Block missing or expired compliance documents"><field name="rental_block_expired_documents"/></setting><setting string="Require working tracker"><field name="rental_block_tracker"/></setting><setting string="Late return grace period"><field name="rental_late_grace_hours"/></setting></block><block title="Agreement"><setting string="Approved rental terms"><field name="rental_agreement_terms" placeholder="Enter the approved agreement, responsibilities and damage provisions."/></setting></block></app></xpath></field></record>
    <record id="action_rental_settings" model="ir.actions.act_window"><field name="name">Car Rental Settings</field><field name="res_model">res.config.settings</field><field name="view_mode">form</field><field name="target">current</field><field name="context">{'module': 'car_rental_management_odoo'}</field></record>

    <record id="dashboard_proposal" model="ir.ui.view"><field name="name">rental.dashboard.proposal</field><field name="model">car.rental.dashboard</field><field name="inherit_id" ref="dashboard_connected"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><separator string="Fleet &amp; Financial Control"/><field name="currency_id" invisible="1"/><group col="1"><group string="Fleet operations"><field name="reserved_vehicles"/><field name="maintenance_vehicles"/><field name="damaged_vehicles"/><field name="inspection_vehicles"/></group><group string="Financial position" groups="car_rental_management_odoo.group_rental_manager,car_rental_management_odoo.group_rental_accountant"><field name="rental_income"/><field name="deposits_held"/><field name="damage_recovery"/><field name="maintenance_costs"/></group></group><group string="Fleet utilisation"><field name="period_start"/><field name="period_end"/><field name="utilization"/></group><button name="action_refresh" type="object" string="Refresh Dashboard"/><button name="action_damage" type="object" string="Damage Assessments"/><button name="action_maintenance" type="object" string="Maintenance" groups="car_rental_management_odoo.group_fleet_manager"/><button name="action_deposits" type="object" string="Deposits" groups="car_rental_management_odoo.group_rental_accountant"/><field name="vehicle_ids" readonly="1" groups="car_rental_management_odoo.group_rental_manager,car_rental_management_odoo.group_rental_accountant"><list create="0" delete="0"><field name="fleet_id"/><field name="registration_number"/><field name="status" widget="badge"/><field name="rental_revenue"/><field name="maintenance_cost"/></list></field></xpath><xpath expr="//form" position="attributes"><attribute name="edit">1</attribute></xpath></field></record>

    <menuitem id="menu_rental_inspections" name="Inspections" parent="menu_car_rental_root" action="action_inspections" sequence="45"/>
    <menuitem id="menu_rental_damage" name="Damage Assessments" parent="menu_car_rental_root" action="action_damage" sequence="46"/>
    <menuitem id="menu_rental_deposits" name="Security Deposits" parent="menu_car_rental_root" action="action_deposits" sequence="51" groups="car_rental_management_odoo.group_rental_accountant"/>
    <menuitem id="menu_rental_service" name="Maintenance" parent="menu_car_rental_root" action="action_rental_maintenance" sequence="60" groups="car_rental_management_odoo.group_fleet_manager"/>
    <menuitem id="menu_rental_configuration" name="Configuration" parent="menu_car_rental_root" sequence="90" groups="car_rental_management_odoo.group_rental_manager"/>
    <menuitem id="menu_rental_rates" name="Pricing Rules" parent="menu_rental_configuration" action="action_rates" sequence="1"/>
    <menuitem id="menu_rental_zones" name="Destinations" parent="menu_rental_configuration" action="action_zones" sequence="2"/>
    <menuitem id="menu_rental_categories" name="Vehicle Categories" parent="menu_rental_configuration" action="action_categories" sequence="3"/>
    <menuitem id="menu_rental_settings" name="Settings" parent="menu_rental_configuration" action="action_rental_settings" sequence="10" groups="base.group_system"/>
<record id="reservation_calendar" model="ir.ui.view"><field name="name">rental.reservation.calendar</field><field name="model">car.rental.reservation</field><field name="arch" type="xml"><calendar string="Rental Availability" date_start="pickup_datetime" date_stop="expected_return_datetime" color="vehicle_id" mode="month" quick_create="0" event_open_popup="1"><field name="reference" readonly="0" required="0" placeholder="Generated on save, or enter your reference"/><field name="customer_id"/><field name="vehicle_id"/><field name="destination_id"/><field name="status"/></calendar></field></record><record id="action_car_rental_reservation" model="ir.actions.act_window"><field name="view_mode">list,calendar,form</field></record><record id="vehicle_list_proposal" model="ir.ui.view"><field name="name">rental.vehicle.list.proposal</field><field name="model">car.rental.vehicle</field><field name="inherit_id" ref="view_car_rental_vehicle_list"/><field name="arch" type="xml"><field name="registration_number" position="before"><field name="fleet_id"/><field name="image_1920" widget="image" options="{'size': [48, 48]}"/></field><field name="category" position="replace"><field name="category_id"/></field><field name="daily_price" position="replace"/></field></record></odoo>
