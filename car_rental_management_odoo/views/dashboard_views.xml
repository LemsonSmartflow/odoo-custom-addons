<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- ================================================== -->
    <!-- DASHBOARD RECORD -->
    <!-- ================================================== -->

    <record id="car_rental_dashboard_record" model="car.rental.dashboard">
        <field name="name">Car Rental Dashboard</field>
    </record>


    <!-- ================================================== -->
    <!-- DASHBOARD FORM VIEW -->
    <!-- ================================================== -->

    <record id="view_car_rental_dashboard_form" model="ir.ui.view">

        <field name="name">car.rental.dashboard.form</field>
        <field name="model">car.rental.dashboard</field>

        <field name="arch" type="xml">

            <form string="Car Rental Dashboard"
                  create="0"
                  edit="0"
                  delete="0">

                <sheet>

                    <h1>
                        Car Rental Dashboard
                    </h1>

                    <group>

                        <!-- VEHICLES -->
                        <group string="Vehicles">

                            <field name="total_vehicles"
                                   readonly="1"/>

                            <field name="available_vehicles"
                                   readonly="1"/>

                            <field name="rented_vehicles"
                                   readonly="1"/>

                        </group>


                        <!-- CUSTOMERS AND RENTALS -->
                        <group string="Customers &amp; Rentals">

                            <field name="total_customers"
                                   readonly="1"/>

                            <field name="ongoing_rentals"
                                   readonly="1"/>

                        </group>

                    </group>


                    <!-- FINANCIAL -->
                    <group string="Financial">

                        <field name="revenue"
                               readonly="1"/>

                    </group>

                </sheet>

            </form>

        </field>

    </record>


    <!-- ================================================== -->
    <!-- DASHBOARD ACTION -->
    <!-- ================================================== -->

    <record id="action_car_rental_dashboard"
            model="ir.actions.act_window">

        <field name="name">Dashboard</field>
        <field name="res_model">car.rental.dashboard</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="car_rental_dashboard_record"/>

    </record>


    <!-- ================================================== -->
    <!-- DASHBOARD MENU -->
    <!-- ================================================== -->

    <menuitem
        id="menu_car_rental_dashboard"
        name="Dashboard"
        parent="menu_car_rental_root"
        action="action_car_rental_dashboard"
        sequence="1"
    />

</odoo>