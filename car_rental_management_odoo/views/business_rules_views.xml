<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="rental_schedule_business" model="ir.ui.view">
        <field name="name">rental.schedule.business</field>
        <field name="model">car.rental.rental</field>
        <field name="inherit_id" ref="rental_form_proposal"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='rental_summary']/field[@name='start_date']" position="replace"><field name="pickup_datetime"/><field name="expected_return_datetime"/></xpath>
            <xpath expr="//group[@name='rental_summary']/field[@name='return_date']" position="replace"/>
        </field>
    </record>
    <record id="action_car_rental_reservation" model="ir.actions.act_window">
        <field name="search_view_id" ref="view_car_rental_reservation_search"/>
        <field name="context">{}</field>
    </record>
    <record id="action_car_rental_rental" model="ir.actions.act_window">
        <field name="search_view_id" ref="view_car_rental_rental_search"/>
        <field name="context">{}</field>
    </record>
</odoo>
