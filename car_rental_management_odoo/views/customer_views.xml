<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <!-- Customers are standard Contacts (res.partner); rental identity data lives
         on the contact's "Rental Details" tab (see native_ui_views.xml). -->

    <!-- ========================= -->
    <!-- CUSTOMER ACTION -->
    <!-- ========================= -->

    <record id="action_car_rental_customer" model="ir.actions.act_window">
      <field name="name">Customers</field>
      <field name="res_model">res.partner</field>
      <field name="view_mode">list,form</field>
    </record>


    <!-- ========================= -->
    <!-- MAIN MENU -->
    <!-- ========================= -->

    <menuitem id="menu_car_rental_root" name="Car Rental" sequence="10"/>


    <!-- ========================= -->
    <!-- CUSTOMER MENU -->
    <!-- ========================= -->

    <menuitem id="menu_car_rental_customer" name="Customers" parent="menu_car_rental_root" action="action_car_rental_customer" sequence="10"/>


</odoo>
