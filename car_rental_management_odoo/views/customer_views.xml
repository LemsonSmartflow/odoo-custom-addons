<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- ========================= -->
    <!-- CUSTOMER LIST VIEW -->
    <!-- ========================= -->

    <record id="view_car_rental_customer_list" model="ir.ui.view">
        <field name="name">car.rental.customer.list</field>
        <field name="model">car.rental.customer</field>

        <field name="arch" type="xml">
            <list string="Customers">

                <field name="first_name"/>
                <field name="last_name"/>
                <field name="cin"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="driving_license"/>
                <field name="license_expiry"/>

            </list>
        </field>
    </record>


    <!-- ========================= -->
    <!-- CUSTOMER FORM VIEW -->
    <!-- ========================= -->

    <record id="view_car_rental_customer_form" model="ir.ui.view">
        <field name="name">car.rental.customer.form</field>
        <field name="model">car.rental.customer</field>

        <field name="arch" type="xml">

            <form string="Customer">

                <sheet>

                    <group>

                        <group string="Personal Information">

                            <field name="first_name"/>
                            <field name="last_name"/>
                            <field name="cin"/>
                            <field name="phone"/>

                        </group>

                        <group string="Contact Information">

                            <field name="email"/>
                            <field name="active"/>

                        </group>

                    </group>


                    <group string="Driving License">

                        <field name="driving_license"/>
                        <field name="license_expiry"/>

                    </group>


                    <group string="Address">

                        <field name="address"/>

                    </group>

                </sheet>

            </form>

        </field>

    </record>


    <!-- ========================= -->
    <!-- CUSTOMER SEARCH VIEW -->
    <!-- ========================= -->

    <record id="view_car_rental_customer_search" model="ir.ui.view">

        <field name="name">car.rental.customer.search</field>
        <field name="model">car.rental.customer</field>

        <field name="arch" type="xml">

            <search string="Search Customers">

                <field name="first_name"/>
                <field name="last_name"/>
                <field name="cin"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="driving_license"/>

            </search>

        </field>

    </record>


    <!-- ========================= -->
    <!-- CUSTOMER ACTION -->
    <!-- ========================= -->

    <record id="action_car_rental_customer" model="ir.actions.act_window">
      <field name="name">Customers</field>
      <field name="res_model">car.rental.customer</field>
      <field name="view_mode">list,form</field>
    </record>


    <!-- ========================= -->
    <!-- MAIN MENU -->
    <!-- ========================= -->

    <menuitem
        id="menu_car_rental_root"
        name="Car Rental"
        sequence="10"
    />


    <!-- ========================= -->
    <!-- CUSTOMER MENU -->
    <!-- ========================= -->

    <menuitem
        id="menu_car_rental_customer"
        name="Customers"
        parent="menu_car_rental_root"
        action="action_car_rental_customer"
        sequence="10"
    />


</odoo>