<odoo>
<record id="access_digital_contract_staff" model="ir.model.access"><field name="name">Digital contract staff</field><field name="model_id" ref="model_car_rental_contract"/><field name="group_id" ref="group_car_rental_agent"/><field name="perm_read" eval="True"/><field name="perm_write" eval="True"/><field name="perm_create" eval="True"/></record>
<record id="access_digital_signer_staff" model="ir.model.access"><field name="name">Digital signers staff</field><field name="model_id" ref="model_car_rental_contract_signer"/><field name="group_id" ref="group_car_rental_agent"/><field name="perm_read" eval="True"/><field name="perm_create" eval="True"/><field name="perm_write" eval="True"/></record>
<record id="rule_digital_contract_company" model="ir.rule"><field name="name">Digital contract company isolation</field><field name="model_id" ref="model_car_rental_contract"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="rule_digital_signer_company" model="ir.rule"><field name="name">Digital signer company isolation</field><field name="model_id" ref="model_car_rental_contract_signer"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="digital_contract_form" model="ir.ui.view"><field name="name">Digital agreement</field><field name="model">car.rental.contract</field><field name="arch" type="xml">
<form class="o_car_rental_form"><header>
<button name="action_prepare" type="object" string="Prepare Signing Links" class="btn-primary" invisible="state != 'draft'"/>
<button name="action_revoke" type="object" string="Revoke Agreement" invisible="state in ('complete','cancelled')" groups="car_rental_management_odoo.group_rental_manager" confirm="Disable every link for this agreement? Recorded signatures will be retained."/>
<field name="state" widget="statusbar"/></header><sheet>
<div class="alert alert-info">Complete the particulars and name all six signers. Share the renter link first. After the renter signs, the company representative and four witnesses can review the same document and sign through their individual links. No emails or messages are sent automatically.</div>
<group string="Booking"><field name="rental_id" readonly="1"/><field name="company_id" readonly="1"/></group>
<group string="Contract particulars"><field name="delivery_place" required="1" readonly="state != 'draft'"/><field name="payment_advance_days" readonly="state != 'draft'"/><field name="company_email" required="1" readonly="state != 'draft'"/></group>
<group string="Named company representative and witnesses">
<field name="company_representative" required="1" readonly="state != 'draft'"/><field name="company_witness_1" required="1" readonly="state != 'draft'"/><field name="company_witness_2" required="1" readonly="state != 'draft'"/><field name="renter_witness_1" required="1" readonly="state != 'draft'"/><field name="renter_witness_2" required="1" readonly="state != 'draft'"/></group>
<separator string="Private signing links — share only with the named person"/>
<field name="signer_ids"><list create="0" delete="0"><field name="role"/><field name="name"/><field name="link" widget="url"/><field name="signed_on"/></list><form><group><field name="role"/><field name="name"/><field name="link" widget="url"/><field name="signed_on"/><field name="signed_hash"/><field name="signature" widget="image"/></group></form></field>
<group string="Version and downloads" invisible="state == 'draft'"><field name="template_version"/><field name="source_filename" invisible="1"/><field name="source_pdf" filename="source_filename"/><field name="source_hash"/><field name="expires_on"/><field name="submitted_on"/><field name="document_hash"/><field name="completed_filename" invisible="1"/><field name="completed_pdf" filename="completed_filename" invisible="state != 'complete'"/></group>
<notebook><page string="Recorded particulars"><field name="particulars_html" nolabel="1"/></page></notebook>
</sheet><chatter/></form></field></record>
<record id="rental_digital_contract_button" model="ir.ui.view"><field name="name">Rental digital agreement</field><field name="model">car.rental.rental</field><field name="inherit_id" ref="view_car_rental_rental_form"/><field name="priority">110</field><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_digital_contract" type="object" string="Digital Agreement"/></xpath></field></record>
<record id="journey_digital_contract_button" model="ir.ui.view"><field name="name">Booking digital agreement</field><field name="model">car.rental.journey</field><field name="inherit_id" ref="booking_journey_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_digital_contract" type="object" string="Customer Digital Agreement" invisible="not rental_id"/></xpath></field></record>
<record id="settings_digital_contract" model="ir.ui.view"><field name="name">Digital contract settings</field><field name="model">res.config.settings</field><field name="inherit_id" ref="base.res_config_settings_view_form"/><field name="arch" type="xml"><xpath expr="//form" position="inside"><app string="Digital Rental Agreement" name="digital_rental_contract" groups="car_rental_management_odoo.group_rental_manager"><block title="Agreement template for the active company"><setting string="Original contract PDF" help="Existing issued agreements retain their original template and completed schedule."><field name="cr_contract_filename" invisible="1"/><field name="cr_contract_pdf" filename="cr_contract_filename"/><field name="cr_contract_version"/><button name="action_load_city_contract" type="object" string="Load Supplied City Delights Contract" confirm="Set the supplied City Delights PDF as this company's template? Existing issued agreements remain unchanged."/></setting></block></app></xpath></field></record>
</odoo>
