<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <!-- Vehicles are standard Fleet vehicles (fleet.vehicle); rental setup data
         lives on the vehicle's "Rental Details" tab (see native_ui_views.xml). -->

    <!-- ========================= -->
    <!-- VEHICLE ACTION -->
    <!-- ========================= -->

    <record id="action_car_rental_vehicle" model="ir.actions.act_window">

        <field name="name">Vehicles</field>
        <field name="res_model">fleet.vehicle</field>
        <field name="view_mode">kanban,list,form</field>

    </record>


    <!-- ========================= -->
    <!-- VEHICLE MENU -->
    <!-- ========================= -->

    <menuitem id="menu_car_rental_vehicle" name="Vehicles" parent="menu_car_rental_root" action="action_car_rental_vehicle" sequence="20"/>

</odoo>
