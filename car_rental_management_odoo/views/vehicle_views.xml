<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <!-- ========================= -->
    <!-- VEHICLE LIST VIEW -->
    <!-- ========================= -->

    <record id="view_car_rental_vehicle_list" model="ir.ui.view">
        <field name="name">car.rental.vehicle.list</field>
        <field name="model">car.rental.vehicle</field>

        <field name="arch" type="xml">
            <list string="Vehicles">

                <field name="registration_number"/>
                <field name="brand" string="Make"/>
                <field name="model"/>
                <field name="year"/>
                <field name="category"/>
                <field name="fuel_type"/>
                <field name="transmission"/>
                <field name="mileage"/>
                <field name="daily_price"/>
                <field name="status"/>

            </list>
        </field>
    </record>


    <!-- ========================= -->
    <!-- VEHICLE FORM VIEW -->
    <!-- ========================= -->

    <record id="view_car_rental_vehicle_form" model="ir.ui.view">
        <field name="name">car.rental.vehicle.form</field>
        <field name="model">car.rental.vehicle</field>

        <field name="arch" type="xml">

            <form string="Vehicle" class="o_car_rental_form">

                <sheet>

                    <field name="image_1920" widget="image" class="oe_avatar" options="{'size': [150, 150]}"/>

                    <group col="1">

                        <group string="Vehicle Information">

                            <field name="registration_number"/>
                            <field name="brand" string="Make"/>
                            <field name="model"/>
                            <field name="year"/>
                            <field name="color"/>
                            <field name="category"/>

                        </group>

                        <group string="Technical Information">

                            <field name="fuel_type"/>
                            <field name="transmission"/>
                            <field name="seats"/>
                            <field name="mileage"/>
                            <field name="daily_price"/>
                            <field name="status"/>

                        </group>

                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <!-- ========================= -->
    <!-- VEHICLE SEARCH VIEW -->
    <!-- ========================= -->

    <record id="view_car_rental_vehicle_search" model="ir.ui.view">

        <field name="name">car.rental.vehicle.search</field>
        <field name="model">car.rental.vehicle</field>

        <field name="arch" type="xml">

            <search string="Search Vehicles">

                <field name="registration_number"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="category"/>
                <field name="status"/>

                <filter name="available" string="Available" domain="[('status', '=', 'available')]"/>

                <filter name="rented" string="Rented" domain="[('status', '=', 'rented')]"/>

                <filter name="maintenance" string="Maintenance" domain="[('status', '=', 'maintenance')]"/>

            </search>

        </field>

    </record>


    <!-- ========================= -->
    <!-- VEHICLE ACTION -->
    <!-- ========================= -->

    <record id="action_car_rental_vehicle" model="ir.actions.act_window">

        <field name="name">Vehicles</field>
        <field name="res_model">car.rental.vehicle</field>
        <field name="view_mode">list,form</field>

    </record>


    <!-- ========================= -->
    <!-- VEHICLE MENU -->
    <!-- ========================= -->

    <menuitem id="menu_car_rental_vehicle" name="Vehicles" parent="menu_car_rental_root" action="action_car_rental_vehicle" sequence="20"/>

</odoo>
