<odoo>
<record id="access_rental_collection" model="ir.model.access"><field name="name">Combined rental collection</field><field name="model_id" ref="model_car_rental_collection"/><field name="group_id" ref="group_rental_accountant"/><field name="perm_read" eval="True"/><field name="perm_create" eval="True"/><field name="perm_write" eval="True"/></record>
<record id="rental_collection_form" model="ir.ui.view"><field name="name">Payment and security deposit</field><field name="model">car.rental.collection</field><field name="arch" type="xml">
<form string="Payment &amp; Security Deposit" class="o_car_rental_form">
<field name="currency_id" invisible="1"/><field name="posted" invisible="1"/>
<group string="Customer and booking"><field name="rental_id"/><field name="customer_id"/><field name="journal_id"/></group>
<group string="Amount to collect"><field name="rental_due"/><field name="deposit_due"/><field name="total_due"/></group>
<group string="Payment received"><field name="amount"/><field name="payment_method"/><field name="date"/><field name="reference"/></group>
<div class="alert alert-info">For a partial payment, the security deposit is funded first; the remainder pays the rental invoice. The first deposit must be at least 50% of one daily rate. Recording this payment also creates and posts the rental invoice if needed.</div>
<group string="Automatic allocation"><field name="to_deposit"/><field name="to_rental"/><field name="remaining"/></group>
<footer><button name="action_post" type="object" string="Record Payment &amp; Deposit" class="btn-primary" invisible="posted"/><button special="cancel" string="Cancel"/></footer>
</form></field></record>
<record id="journey_combined_collection" model="ir.ui.view"><field name="name">Combined payment and deposit collection</field><field name="model">car.rental.journey</field><field name="inherit_id" ref="booking_journey_form"/><field name="priority">120</field><field name="arch" type="xml">
<xpath expr="//button[@name='action_invoice']" position="replace"><button name="action_collect_payment" type="object" string="Payment &amp; Security Deposit" class="btn-primary" groups="car_rental_management_odoo.group_rental_accountant"/></xpath>
<xpath expr="//button[@name='action_payment']" position="replace"/><xpath expr="//button[@name='action_deposit']" position="replace"/>
<xpath expr="//group[button[@name='action_collect_payment']]/div" position="replace"><div colspan="2">Enter the received amount once. The allocation preview shows the rental payment, refundable deposit and remaining balance. Both entries are recorded together.</div></xpath>
</field></record>
<record id="rental_combined_collection" model="ir.ui.view"><field name="name">Rental combined collection</field><field name="model">car.rental.rental</field><field name="inherit_id" ref="view_car_rental_rental_form"/><field name="priority">130</field><field name="arch" type="xml">
<xpath expr="//button[@name='action_record_payment']" position="attributes"><attribute name="string">Payment &amp; Security Deposit</attribute><attribute name="invisible">status == 'closed'</attribute><attribute name="groups">car_rental_management_odoo.group_rental_accountant</attribute></xpath>
<xpath expr="//button[@name='action_collect_deposit']" position="replace"><button name="action_collect_payment" type="object" string="Payment &amp; Security Deposit" class="btn-primary" invisible="status != 'draft'" groups="car_rental_management_odoo.group_rental_accountant"/></xpath>
</field></record>
</odoo>
