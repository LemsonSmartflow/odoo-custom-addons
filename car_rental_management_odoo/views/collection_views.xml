<odoo>
    <record id="access_rental_collection" model="ir.model.access">
        <field name="name">Combined rental collection</field>
        <field name="model_id" ref="model_car_rental_collection"/>
        <field name="group_id" ref="group_rental_accountant"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="True"/>
    </record>
    <record id="rental_collection_form" model="ir.ui.view">
        <field name="name">Payment and security deposit</field>
        <field name="model">car.rental.collection</field>
        <field name="arch" type="xml">
            <form string="Booking Payment" class="o_car_rental_form">
                <field name="currency_id" invisible="1"/>
                <field name="posted" invisible="1"/>
                <field name="single_invoice" invisible="1"/>
                <group string="Customer and booking">
                    <field name="rental_id"/>
                    <field name="partner_id"/>
                    <field name="journal_id"/>
                </group>
                <group string="Booking invoice" invisible="not single_invoice">
                    <field name="rental_due" string="Invoice Balance"/>
                    <field name="deposit_credit_available"/>
                    <field name="credit_to_apply"/>
                </group>
                <group string="Prior deposit credit" invisible="single_invoice">
                    <field name="deposit_credit_available"/>
                    <field name="credit_to_apply"/>
                    <div colspan="2" class="text-muted">
                        Credit is transferred from settled, refundable deposits on this customer's returned rentals.
                    </div>
                </group>
                <group string="Legacy rental balance" invisible="single_invoice">
                    <field name="rental_due"/>
                    <field name="deposit_due"/>
                    <field name="total_due"/>
                </group>
                <group string="Payment received">
                    <field name="amount"/>
                    <field name="payment_method"/>
                    <field name="date"/>
                    <field name="reference"/>
                </group>
                <div class="alert alert-info" invisible="not single_invoice">
                    Payment and eligible prior deposit credit are applied to the single hire and security-deposit invoice.
                </div>
                <div class="alert alert-info" invisible="single_invoice">
                    Legacy rentals continue to allocate the collection to the refundable deposit first, then the hire invoice.
                </div>
                <group string="Legacy allocation" invisible="single_invoice">
                    <field name="to_deposit"/>
                    <field name="to_rental"/>
                    <field name="remaining"/>
                </group>
                <footer>
                    <button name="action_post" type="object" string="Record Payment"
                            class="btn-primary" invisible="posted"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="rental_combined_collection" model="ir.ui.view">
        <field name="name">Rental combined collection</field>
        <field name="model">car.rental.rental</field>
        <field name="inherit_id" ref="view_car_rental_rental_form"/>
        <field name="priority">130</field>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_record_payment']" position="attributes">
                <attribute name="string">Payment &amp; Security Deposit</attribute>
                <attribute name="invisible">status == 'closed'</attribute>
                <attribute name="groups">car_rental_management_odoo.group_rental_accountant</attribute>
            </xpath>
            <xpath expr="//button[@name='action_collect_deposit']" position="replace">
                <button name="action_collect_payment" type="object"
                        string="Payment &amp; Security Deposit" class="btn-primary"
                        invisible="status != 'draft'"
                        groups="car_rental_management_odoo.group_rental_accountant"/>
            </xpath>
        </field>
    </record>
</odoo>
