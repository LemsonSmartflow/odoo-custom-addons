<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <!-- ========================= -->
    <!-- PAYMENT LIST VIEW -->
    <!-- ========================= -->

    <record id="view_car_rental_payment_list" model="ir.ui.view">
        <field name="name">car.rental.payment.list</field>
        <field name="model">car.rental.payment</field>

        <field name="arch" type="xml">
            <list string="Payments">

                <field name="reference"/>
                <field name="rental_id"/>
                <field name="payment_date"/>
                <field name="total_amount"/>
                <field name="paid_amount"/>
                <field name="remaining_amount"/>
                <field name="payment_method"/>
                <field name="status"/>

            </list>
        </field>
    </record>


    <!-- ========================= -->
    <!-- PAYMENT FORM VIEW -->
    <!-- ========================= -->

    <record id="view_car_rental_payment_form" model="ir.ui.view">
        <field name="name">car.rental.payment.form</field>
        <field name="model">car.rental.payment</field>

        <field name="arch" type="xml">

            <form string="Payment" class="o_car_rental_form">

                <sheet>

                    <group col="1">

                        <group string="Payment Information">

                            <field name="reference"/>

                            <field name="rental_id"/>

                            <field name="payment_date"/>

                            <field name="payment_method"/>

                        </group>


                        <group string="Amounts">

                            <field name="total_amount" readonly="1"/>

                            <field name="paid_amount"/>

                            <field name="remaining_amount" readonly="1"/>

                            <field name="status" readonly="1"/>

                        </group>

                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <!-- ========================= -->
    <!-- PAYMENT SEARCH VIEW -->
    <!-- ========================= -->

    <record id="view_car_rental_payment_search" model="ir.ui.view">

        <field name="name">car.rental.payment.search</field>
        <field name="model">car.rental.payment</field>

        <field name="arch" type="xml">

            <search string="Search Payments">

                <field name="reference"/>
                <field name="rental_id"/>
                <field name="payment_date"/>
                <field name="payment_method"/>
                <field name="status"/>

                <filter name="unpaid" string="Unpaid" domain="[('status', '=', 'unpaid')]"/>

                <filter name="partial" string="Partially Paid" domain="[('status', '=', 'partial')]"/>

                <filter name="paid" string="Paid" domain="[('status', '=', 'paid')]"/>

            </search>

        </field>

    </record>


    <!-- ========================= -->
    <!-- PAYMENT ACTION -->
    <!-- ========================= -->

    <record id="action_car_rental_payment" model="ir.actions.act_window">

        <field name="name">Payments</field>
        <field name="res_model">car.rental.payment</field>
        <field name="view_mode">list,form</field>

    </record>


    <!-- ========================= -->
    <!-- PAYMENT MENU -->
    <!-- ========================= -->

    <menuitem id="menu_car_rental_payment" name="Payments" parent="menu_car_rental_root" action="action_car_rental_payment" sequence="50"/>

</odoo>
