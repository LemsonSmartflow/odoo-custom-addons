<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="sequence_reservation" model="ir.sequence">
        <field name="name">Car Rental Reservation</field>
        <field name="code">car.rental.reservation</field>
        <field name="prefix">RES/</field>
        <field name="padding">5</field>
    </record>
    <record id="sequence_rental" model="ir.sequence">
        <field name="name">Car Rental</field>
        <field name="code">car.rental.rental</field>
        <field name="prefix">RENT/</field>
        <field name="padding">5</field>
    </record>
    <record id="sequence_payment" model="ir.sequence">
        <field name="name">Car Rental Payment</field>
        <field name="code">car.rental.payment</field>
        <field name="prefix">PAY/</field>
        <field name="padding">5</field>
    </record>
</odoo>
