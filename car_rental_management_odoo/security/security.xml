<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="module_category_car_rental" model="ir.module.category">
        <field name="name">Car Rental</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_car_rental" model="res.groups.privilege">
        <field name="name">Car Rental</field>
        <field name="category_id" ref="module_category_car_rental"/>
        <field name="sequence">20</field>
    </record>

    <record id="group_car_rental_agent" model="res.groups">
        <field name="name">Rental Staff</field>
        <field name="privilege_id" ref="privilege_car_rental"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_car_rental_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_car_rental"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_car_rental_agent'))]"/>
    </record>

    <record id="privilege_cr_fleet" model="res.groups.privilege"><field name="name">Rental Fleet</field><field name="category_id" ref="module_category_car_rental"/></record>
    <record id="privilege_cr_finance" model="res.groups.privilege"><field name="name">Rental Finance</field><field name="category_id" ref="module_category_car_rental"/></record>
    <record id="group_rental_manager" model="res.groups">
        <field name="name">Rental Manager</field><field name="privilege_id" ref="privilege_car_rental"/><field name="sequence">15</field>
        <field name="implied_ids" eval="[(4, ref('group_car_rental_agent')), (4, ref('sales_team.group_sale_salesman')), (4, ref('account.group_account_readonly'))]"/>
    </record>
    <record id="group_fleet_manager" model="res.groups">
        <field name="name">Fleet Manager</field><field name="privilege_id" ref="privilege_cr_fleet"/>
        <field name="implied_ids" eval="[(4, ref('group_car_rental_agent')), (4, ref('fleet.fleet_group_user')), (4, ref('maintenance.group_equipment_manager'))]"/>
    </record>
    <record id="group_rental_accountant" model="res.groups">
        <field name="name">Accountant</field><field name="privilege_id" ref="privilege_cr_finance"/>
        <field name="implied_ids" eval="[(4, ref('group_car_rental_agent')), (4, ref('account.group_account_user'))]"/>
    </record>
    <record id="group_car_rental_admin" model="res.groups"><field name="implied_ids" eval="[(4, ref('group_rental_manager')), (4, ref('group_fleet_manager')), (4, ref('group_rental_accountant'))]"/></record>
<record id="rule_company_customer" model="ir.rule"><field name="name">Car Rental company isolation: customer</field><field name="model_id" ref="model_car_rental_customer"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record><record id="rule_company_vehicle" model="ir.rule"><field name="name">Car Rental company isolation: vehicle</field><field name="model_id" ref="model_car_rental_vehicle"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record><record id="rule_company_reservation" model="ir.rule"><field name="name">Car Rental company isolation: reservation</field><field name="model_id" ref="model_car_rental_reservation"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record><record id="rule_company_rental" model="ir.rule"><field name="name">Car Rental company isolation: rental</field><field name="model_id" ref="model_car_rental_rental"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record><record id="rule_company_payment" model="ir.rule"><field name="name">Car Rental company isolation: payment</field><field name="model_id" ref="model_car_rental_payment"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record><record id="rule_company_dashboard" model="ir.rule"><field name="name">Car Rental company isolation: dashboard</field><field name="model_id" ref="model_car_rental_dashboard"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record><record id="rule_company_category" model="ir.rule"><field name="name">Car Rental company isolation: category</field><field name="model_id" ref="model_car_rental_category"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record><record id="rule_company_zone" model="ir.rule"><field name="name">Car Rental company isolation: zone</field><field name="model_id" ref="model_car_rental_zone"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record><record id="rule_company_rate_rule" model="ir.rule"><field name="name">Car Rental company isolation: rate.rule</field><field name="model_id" ref="model_car_rental_rate_rule"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record><record id="rule_company_check" model="ir.rule"><field name="name">Car Rental company isolation: check</field><field name="model_id" ref="model_car_rental_check"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record><record id="rule_company_damage_case" model="ir.rule"><field name="name">Car Rental company isolation: damage.case</field><field name="model_id" ref="model_car_rental_damage_case"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record><record id="rule_company_deposit_transaction" model="ir.rule"><field name="name">Car Rental company isolation: deposit.transaction</field><field name="model_id" ref="model_car_rental_deposit_transaction"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record><record id="rule_rental_maintenance_accountant" model="ir.rule"><field name="name">Rental accountants: rental maintenance expenses</field><field name="model_id" ref="maintenance.model_maintenance_request"/><field name="groups" eval="[(4, ref('group_rental_accountant'))]"/><field name="domain_force">[('rental_vehicle_id', '!=', False)]</field></record></odoo>
