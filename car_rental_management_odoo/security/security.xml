<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="module_category_car_rental" model="ir.module.category">
        <field name="name">Car Rental</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_car_rental" model="res.groups.privilege">
        <field name="name">Car Rental</field>
        <field name="category_id" ref="module_category_car_rental"/>
        <field name="sequence">20</field>
    </record>

    <record id="group_car_rental_agent" model="res.groups">
        <field name="name">Agent</field>
        <field name="privilege_id" ref="privilege_car_rental"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_car_rental_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_car_rental"/>
        <field name="sequence">20</field>
        <field name="implied_ids"
               eval="[(4, ref('group_car_rental_agent'))]"/>
    </record>

</odoo>