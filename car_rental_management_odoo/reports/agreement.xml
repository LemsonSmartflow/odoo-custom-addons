<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="report_rental_agreement" model="ir.actions.report"><field name="name">Rental Agreement &amp; Condition Record</field><field name="model">car.rental.rental</field><field name="report_type">qweb-pdf</field><field name="report_name">car_rental_management_odoo.rental_agreement</field><field name="binding_model_id" ref="model_car_rental_rental"/><field name="binding_type">report</field></record>
    <template id="rental_agreement"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h1>Vehicle Rental Agreement</h1><h2 t-field="o.reference"/><div class="row"><div class="col-6"><h3>Customer</h3><p><span t-field="o.customer_id.display_name"/><br/>ID: <span t-field="o.customer_id.cin"/><br/>Driving licence: <span t-field="o.customer_id.driving_license"/><br/>Phone: <span t-field="o.customer_id.phone"/></p></div><div class="col-6"><h3>Vehicle</h3><p><span t-field="o.vehicle_id.display_name"/><br/>VIN: <span t-field="o.vehicle_id.vin"/><br/>Destination: <span t-field="o.destination_id.name"/></p><img t-if="o.vehicle_id.image_1920" t-att-src="image_data_uri(o.vehicle_id.image_1920)" style="max-width:240px; max-height:140px"/></div></div><table class="table table-sm"><tbody><tr><th>Scheduled pickup</th><td><span t-field="o.reservation_id.pickup_datetime"/></td><th>Scheduled return</th><td><span t-field="o.expected_return_datetime"/></td></tr><tr><th>Daily rate</th><td><span t-field="o.reservation_id.quoted_daily_rate"/></td><th>Rental total</th><td><span t-field="o.amount"/></td></tr><tr><th>Security deposit</th><td><span t-field="o.deposit_required"/></td><th>Deposit held</th><td><span t-field="o.deposit_held"/></td></tr></tbody></table><h3>Terms, responsibilities &amp; damage provisions</h3><p style="white-space:pre-wrap" t-field="o.agreement_terms"/><h3>Condition Record</h3><t t-foreach="o.inspection_ids.filtered(lambda c: c.state == 'done')" t-as="check"><h4><span t-field="check.kind"/> — <span t-field="check.checked_on"/></h4><p>Mileage: <span t-field="check.mileage"/> · Fuel: <span t-field="check.fuel_level"/></p><p>Exterior: <span t-field="check.exterior"/><br/>Interior: <span t-field="check.interior"/><br/>Tyres: <span t-field="check.tyres"/><br/>Accessories: <span t-field="check.accessories"/><br/>Existing damage: <span t-field="check.existing_damage"/><br/>New damage: <span t-field="check.damage_notes"/></p></t><h3>Customer acknowledgement</h3><p><span t-field="o.agreement_signed_by"/> · <span t-field="o.agreement_signed_on"/></p><img t-if="o.agreement_signature" t-att-src="image_data_uri(o.agreement_signature)" style="max-width:260px; max-height:100px"/><p t-if="o.agreement_state != 'signed'">DRAFT — awaiting customer acknowledgement.</p></div></t></t></t></template>
</odoo>
